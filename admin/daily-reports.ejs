<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --navy:#0A1628; --navy-2:#142238; --offwhite:#FAFAF7; --beige:#F4EFE6; --muted:#6b6b6b; --border:rgba(10,22,40,0.08); --shadow:0 4px 24px rgba(10,22,40,0.06); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--offwhite); color:#1a1a1a; min-height:100vh; display:flex; }
    h1,h2 { font-family:'Playfair Display',serif; color:var(--navy); }
    .main-content { flex:1; margin-left:260px; min-height:100vh; display:flex; flex-direction:column; }
    .page-body { padding:28px 40px; flex:1; }
    .page-hero { background:linear-gradient(135deg,var(--navy),var(--navy-2)); color:var(--offwhite); padding:22px 30px; border-radius:16px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; box-shadow:var(--shadow); }
    .page-hero h1 { color:var(--offwhite); font-size:24px; }
    .page-hero p { color:rgba(250,250,247,0.7); font-size:13px; margin-top:3px; }
    .toolbar { display:flex; gap:8px; align-items:center; }
    .toolbar input { padding:8px 10px; border-radius:8px; border:1px solid rgba(212,175,55,0.4); }
    .toolbar button { background:var(--gold); color:var(--navy); border:none; border-radius:8px; padding:9px 15px; font-weight:700; cursor:pointer; }
    .panel { background:#fff; border-radius:14px; box-shadow:var(--shadow); overflow:hidden; margin-bottom:24px; }
    .panel h2 { font-size:16px; padding:16px 20px 6px; }
    .sub { font-size:12px; color:var(--muted); padding:0 20px 12px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); padding:10px 14px; border-bottom:2px solid var(--border); background:var(--beige); }
    th.num, td.num { text-align:right; }
    td { padding:10px 14px; border-bottom:1px solid var(--border); }
    tr.missing td { background:rgba(220,38,38,0.05); }
    .cname { font-weight:600; color:var(--navy); }
    .selfsys { display:inline-flex; gap:6px; align-items:baseline; }
    .self { font-weight:700; color:var(--navy); }
    .sys { font-size:11px; color:#2563EB; }
    .stpill { font-size:11px; font-weight:700; padding:2px 8px; border-radius:999px; }
    .stpill.yes { background:#DCFCE7; color:#166534; } .stpill.no { background:#FEE2E2; color:#991B1B; } .stpill.pending { background:#F3F4F6; color:#6B7280; }
    .empty { text-align:center; color:var(--muted); padding:26px; font-style:italic; }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">
      <div class="page-hero">
        <div>
          <h1>Daily Reports</h1>
          <p><%= date %> &middot; <%= submittedCount %>/<%= total %> submitted &middot; self-report vs system truth</p>
        </div>
        <form class="toolbar" method="get" action="/admin/reports/daily">
          <input type="date" name="date" value="<%= date %>" max="2100-12-31">
          <button type="submit">View</button>
        </form>
      </div>

      <div class="panel">
        <h2>Submissions — <%= date %></h2>
        <div class="sub">Each cell shows the exec's self-report; the small blue number is the system-counted truth. Mapping: Calls → <strong>FU(sys)</strong> = follow-ups logged that day · Visits → site-visits completed/booked that day · New Leads → <strong>sys*</strong> = leads assigned to them that day (no lead-creator field in the schema). Not-submitted rows tinted red only for past dates and today after 8 PM.</div>
        <table>
          <thead>
            <tr><th>Executive</th><th class="num">Calls</th><th class="num">Follow-ups</th><th class="num">Visits</th><th class="num">New Leads</th><th>Notes</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% if (rows && rows.length) { %>
              <% rows.forEach(function(r) { %>
                <tr class="<%= (!r.submitted && highlightMissing) ? 'missing' : '' %>">
                  <td class="cname"><%= r.name %> <span style="color:#9ca3af;">(<%= r.external_id %>)</span></td>
                  <td class="num"><span class="selfsys"><span class="self"><%= r.submitted ? r.calls_made : '—' %></span><span class="sys">FU(sys) <%= r.sys_followups %></span></span></td>
                  <td class="num"><span class="self"><%= r.submitted ? r.followups_done : '—' %></span></td>
                  <td class="num"><span class="selfsys"><span class="self"><%= r.submitted ? r.visits_done : '—' %></span><span class="sys">sys <%= r.sys_visits %></span></span></td>
                  <td class="num"><span class="selfsys"><span class="self"><%= r.submitted ? r.new_leads : '—' %></span><span class="sys">sys* <%= r.sys_new_leads %></span></span></td>
                  <td style="max-width:220px;color:var(--muted);font-size:12px;"><%= r.notes || '' %></td>
                  <td><span class="stpill <%= r.submitted ? 'yes' : (highlightMissing ? 'no' : 'pending') %>"><%= r.submitted ? 'submitted' : 'not submitted' %></span></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="7" class="empty">No active staff.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="panel">
        <h2>Weekly Totals</h2>
        <div class="sub">Self-reported totals for the week of <%= weekStart %> &rarr; <%= weekEnd %> (Mon&ndash;Sun).</div>
        <table>
          <thead>
            <tr><th>Executive</th><th class="num">Calls</th><th class="num">Follow-ups</th><th class="num">Visits</th><th class="num">New Leads</th><th class="num">Days Submitted</th></tr>
          </thead>
          <tbody>
            <% if (weekly && weekly.length) { %>
              <% weekly.forEach(function(w) { %>
                <tr>
                  <td class="cname"><%= w.name %> <span style="color:#9ca3af;">(<%= w.external_id %>)</span></td>
                  <td class="num"><%= w.calls %></td>
                  <td class="num"><%= w.followups %></td>
                  <td class="num"><%= w.visits %></td>
                  <td class="num"><%= w.new_leads %></td>
                  <td class="num"><%= w.days_submitted %>/7</td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6" class="empty">No active staff.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
