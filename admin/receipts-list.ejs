<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
      --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6;
      --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08);
      --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .page-hero .gold-line { display: inline-block; width: 36px; height: 3px; background: var(--gold); margin-top: 12px; border-radius: 2px; }
    .hero-actions { position: absolute; top: 28px; right: 32px; z-index: 2; }
    .btn { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; padding: 10px 18px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-navy { background: var(--navy); color: var(--offwhite); }
    .btn-navy:hover { background: var(--navy-2); }
    .btn-sm { padding: 6px 12px; font-size: 12px; }

    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 26px; }
    .kpi-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); }
    .kpi-card .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 8px; }
    .kpi-card .value { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--navy); line-height: 1; }
    .kpi-card .sub { font-size: 12px; color: var(--muted); margin-top: 6px; }
    .kpi-card.collected { border-left: 4px solid var(--green); }
    .kpi-card.collected .value { color: var(--green); }

    .section-title { font-size: 18px; margin: 8px 0 14px; display: flex; align-items: center; gap: 10px; }
    .section-title .dot { width: 7px; height: 7px; background: var(--gold); border-radius: 50%; }
    .panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--muted); padding: 11px 14px; border-bottom: 2px solid var(--border); background: var(--beige); }
    th.num, td.num { text-align: right; }
    td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    .ref { font-family: monospace; font-size: 12px; color: var(--navy); font-weight: 600; }
    .sub-ref { font-family: monospace; font-size: 11px; color: var(--muted); }
    .lead-name { font-weight: 600; color: var(--navy); }
    .flash { padding: 12px 18px; border-radius: 10px; margin-bottom: 16px; font-size: 14px; font-weight: 500; }
    .flash.success { background: rgba(22,163,74,0.10); color: var(--green); border: 1px solid rgba(22,163,74,0.25); }
    .flash.error { background: rgba(220,38,38,0.10); color: var(--red); border: 1px solid rgba(220,38,38,0.25); }
    .empty { text-align: center; color: var(--muted); padding: 40px; font-size: 14px; }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">

      <div class="page-hero">
        <h1>Token Receipts</h1>
        <p>Gapless, snapshot-frozen receipts for every booking token received.</p>
        <span class="gold-line"></span>
        <div class="hero-actions">
          <a href="/admin/bookings" class="btn btn-gold">&#8592; Bookings</a>
        </div>
      </div>

      <% if (typeof messages !== 'undefined' && messages.success && messages.success.length) { %>
        <div class="flash success">&#10003; <%= messages.success %></div>
      <% } %>
      <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
        <div class="flash error"><%= messages.error %></div>
      <% } %>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="label">Receipts Issued</div>
          <div class="value"><%= stats.count %></div>
          <div class="sub">all-time</div>
        </div>
        <div class="kpi-card collected">
          <div class="label">Total Received</div>
          <div class="value">&#8377;<%= Math.round(stats.total).toLocaleString('en-IN') %></div>
          <div class="sub">across all receipts</div>
        </div>
      </div>

      <h2 class="section-title"><span class="dot"></span> All Receipts</h2>
      <div class="panel">
        <% if (receipts.length === 0) { %>
          <div class="empty">No receipts issued yet. Issue one from the <strong>Bookings</strong> page.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Receipt No.</th><th>Booking</th><th>Received From</th><th>Property</th>
                <th class="num">Amount</th><th>Date</th><th>PDF</th>
              </tr>
            </thead>
            <tbody>
              <% receipts.forEach(function(r){ %>
                <tr>
                  <td><span class="ref"><%= r.receipt_no %></span></td>
                  <td><span class="sub-ref"><%= r.booking_ref || '—' %></span></td>
                  <td class="lead-name"><%= r.lead_name || '—' %></td>
                  <td><%= r.property_title || '—' %></td>
                  <td class="num">&#8377;<%= Math.round(Number(r.amount)).toLocaleString('en-IN') %></td>
                  <td><span style="font-size:12px;color:var(--muted);"><%= new Date(r.created_at).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></span></td>
                  <td>
                    <a href="/admin/receipts/<%= r.receipt_id %>/pdf" class="btn btn-navy btn-sm" target="_blank" rel="noopener">&#8681; PDF</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
      <p style="font-size:12px;color:var(--muted);margin-top:10px;font-style:italic;">Receipt numbers are gapless and concurrency-safe. Each PDF is frozen at issue time and never recomputed.</p>

    </div>
  </div>
</body>
</html>
