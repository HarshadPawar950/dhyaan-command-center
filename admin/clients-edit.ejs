<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-dark: #B8941F; --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6; --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08); --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .hero-actions { position: absolute; top: 28px; right: 32px; z-index: 2; }
    .btn { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; padding: 10px 18px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-sm { padding: 6px 10px; font-size: 12px; border-radius: 7px; }
    .btn-view { background: rgba(22,163,74,0.12); color: var(--green); }
    .btn-view:hover { background: var(--green); color: #fff; }
    .btn-edit { background: rgba(37,99,235,0.12); color: var(--blue); }
    .btn-edit:hover { background: var(--blue); color: #fff; }
    .btn-del { background: rgba(220,38,38,0.1); color: var(--red); }
    .btn-del:hover { background: var(--red); color: #fff; }
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 22px; }
    .kpi-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); }
    .kpi-card .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 8px; }
    .kpi-card .value { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--navy); line-height: 1; }
    .kpi-card.total { border-left: 4px solid var(--gold); }
    .kpi-card.investors { border-left: 4px solid var(--blue); }
    .kpi-card.active { border-left: 4px solid var(--green); }
    .flash { background: rgba(22,163,74,0.1); border: 1px solid rgba(22,163,74,0.3); color: var(--green); padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 13px; font-weight: 500; }
    .panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--muted); padding: 11px 14px; border-bottom: 2px solid var(--border); background: var(--beige); }
    th.num, td.num { text-align: right; }
    th.ctr, td.ctr { text-align: center; }
    td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    .cname { font-weight: 600; color: var(--navy); }
    .cmeta { font-size: 11px; color: var(--muted); }
    .badge { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .badge.buyer { background: rgba(37,99,235,0.12); color: var(--blue); }
    .badge.investor { background: rgba(212,175,55,0.18); color: var(--gold-dark); }
    .badge.end_user { background: rgba(22,163,74,0.12); color: var(--green); }
    .badge.active { background: rgba(22,163,74,0.12); color: var(--green); }
    .badge.past { background: rgba(10,22,40,0.08); color: var(--muted); }
    .badge.dormant { background: rgba(217,119,6,0.12); color: var(--amber); }
    .actions { display: flex; gap: 6px; justify-content: center; }
    .empty { text-align: center; color: var(--muted); padding: 40px; font-size: 14px; }
    .inline-form { display: inline; }

    /* --- view + edit additions --- */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 22px; }
    .kpi-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); }
    .kpi-card .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 8px; }
    .kpi-card .value { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--navy); line-height: 1; }
    .kpi-card.paid { border-left: 4px solid var(--green); } .kpi-card.paid .value { color: var(--green); }
    .kpi-card.out { border-left: 4px solid var(--amber); } .kpi-card.props { border-left: 4px solid var(--gold); }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 22px; }
    .info-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 22px; }
    .info-card h3 { font-size: 16px; margin-bottom: 14px; }
    .info-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
    .info-row:last-child { border-bottom: none; } .info-row .k { color: var(--muted); } .info-row .v { color: var(--navy); font-weight: 500; text-align: right; max-width: 60%; }
    .btn-ghost-light { background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.25); }
    .section-title { font-size: 18px; margin: 8px 0 14px; }
    .form-panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 28px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .field { display: flex; flex-direction: column; gap: 6px; } .field.full { grid-column: 1 / -1; }
    label { font-size: 12px; font-weight: 600; color: var(--navy); text-transform: uppercase; letter-spacing: 0.3px; }
    label .req { color: var(--red); }
    input[type=text], input[type=email], input[type=tel], select, textarea { font-family: 'Inter', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--offwhite); color: var(--text); width: 100%; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); background: #fff; }
    textarea { resize: vertical; min-height: 70px; }
    .form-actions { display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <div class="main-content">
    <%- topbarHtml %>
    <div class="page-body">
      <%- include('../partials/breadcrumb', { crumbs:[{label:'Clients',href:'/admin/clients'},{label:'Edit Client'}], backHref:'/admin/clients' }) %>

      <div class="page-hero">
        <h1>Edit Client</h1>
        <p>Update profile, preferences and investment details.</p>
      </div>

      <div class="form-panel">
        <form action="/admin/clients/edit/<%= client.client_id %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-grid">
            <div class="field full"><label>Name <span class="req">*</span></label><input type="text" name="name" required value="<%= client.name || '' %>" /></div>
            <div class="field"><label>Phone</label><input type="tel" name="phone" value="<%= client.phone || '' %>" /></div>
            <div class="field"><label>Email</label><input type="email" name="email" value="<%= client.email || '' %>" /></div>
            <div class="field"><label>Location</label><input type="text" name="location" value="<%= client.location || '' %>" /></div>
            <div class="field"><label>Client Type</label><select name="client_type">
              <% for (var ti = 0; ti < clientTypes.length; ti++) { %>
                <option value="<%= clientTypes[ti] %>" <%= client.client_type === clientTypes[ti] ? 'selected' : '' %>><%= clientTypes[ti] %></option>
              <% } %>
            </select></div>
            <div class="field"><label>Requirement</label><input type="text" name="requirement" value="<%= client.requirement || '' %>" /></div>
            <div class="field"><label>Budget</label><input type="text" name="budget" value="<%= client.budget || '' %>" /></div>
            <div class="field"><label>Status</label><select name="status">
              <% for (var si = 0; si < clientStatuses.length; si++) { %>
                <option value="<%= clientStatuses[si] %>" <%= client.status === clientStatuses[si] ? 'selected' : '' %>><%= clientStatuses[si] %></option>
              <% } %>
            </select></div>
            <div class="field"></div>
            <div class="field full"><label>Preferences</label><textarea name="preferences"><%= client.preferences || '' %></textarea></div>
            <div class="field full"><label>Investment Profile</label><textarea name="investment_profile"><%= client.investment_profile || '' %></textarea></div>
            <div class="field full"><label>Notes</label><textarea name="notes"><%= client.notes || '' %></textarea></div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-gold">Update Client</button>
            <a href="/admin/clients/view/<%= client.client_id %>" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>

    </div>
  </div>
</body>
</html>

