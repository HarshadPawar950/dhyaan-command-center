<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
      --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6;
      --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08);
      --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .page-hero .gold-line { display: inline-block; width: 36px; height: 3px; background: var(--gold); margin-top: 12px; border-radius: 2px; }
    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--gold); text-decoration: none; font-size: 13px; font-weight: 600; margin-bottom: 16px; }
    .flash { padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 14px; font-weight: 500; }
    .flash.success { background: rgba(22,163,74,0.10); color: var(--green); border: 1px solid rgba(22,163,74,0.25); }
    .flash.error { background: rgba(220,38,38,0.10); color: var(--red); border: 1px solid rgba(220,38,38,0.25); }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
    @media (max-width: 1000px) { .grid2 { grid-template-columns: 1fr; } }
    .card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 26px; box-shadow: var(--shadow); margin-bottom: 20px; }
    .card h2 { font-size: 17px; margin-bottom: 4px; }
    .card .sub { font-size: 13px; color: var(--muted); margin-bottom: 18px; }
    .card.danger { border-left: 4px solid var(--amber); }
    .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    label { font-size: 13px; font-weight: 600; color: var(--navy); }
    input, select { font-family: 'Inter', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--offwhite); color: var(--text); width: 100%; }
    input:focus, select:focus { outline: none; border-color: var(--gold); background: #fff; }
    .hint { font-size: 12px; color: var(--muted); }
    .btn { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; padding: 11px 22px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-primary { background: var(--gold); color: var(--navy); }
    .btn-primary:hover { background: var(--gold-dark); color: #fff; }
    .btn-amber { background: var(--amber); color: #fff; }
    .btn-amber:hover { opacity: 0.88; }
    .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .badge.amber { background: rgba(217,119,6,0.12); color: var(--amber); }
    .badge.blue { background: rgba(37,99,235,0.12); color: var(--blue); }
    .badge.navy { background: rgba(10,22,40,0.08); color: var(--navy); }
    .boss-only { background: rgba(212,175,55,0.07); border: 1px dashed var(--gold); }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">
      <a href="/admin/employees" class="back-link">&larr; Back to Employees</a>
      <div class="page-hero">
        <h1>Edit Employee</h1>
        <p><%= emp.name %> &middot; <%= emp.external_id || 'no code' %> &middot;
          <span class="badge <%= emp.access_role === 'super_admin' ? 'amber' : (emp.access_role === 'admin' ? 'blue' : 'navy') %>"><%= emp.access_role || 'employee' %></span>
        </p>
        <span class="gold-line"></span>
      </div>

      <% if (typeof messages !== 'undefined' && messages.success && messages.success.length) { %>
        <div class="flash success"><%= messages.success %></div>
      <% } %>
      <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
        <div class="flash error"><%= messages.error %></div>
      <% } %>

      <!-- DETAILS -->
      <div class="card">
        <h2>Details</h2>
        <div class="sub">Update basic information.</div>
        <form action="/admin/employees/<%= emp.employee_id %>/edit" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid2">
            <div class="field"><label>Full Name</label><input type="text" name="name" value="<%= emp.name || '' %>" required></div>
            <div class="field"><label>Employee Code</label><input type="text" name="external_id" value="<%= emp.external_id || '' %>"></div>
            <div class="field"><label>Email</label><input type="email" name="email" value="<%= emp.email || '' %>" required></div>
            <div class="field"><label>Phone</label><input type="text" name="phone" value="<%= emp.phone || '' %>"></div>
            <div class="field"><label>Job Title</label><input type="text" name="role" value="<%= emp.role || '' %>"></div>
            <% if (/^E[0-9]{3,}$/.test(emp.external_id || '')) { %>
            <div class="field">
              <label>Reports To</label>
              <select name="reports_to">
                <option value="">&mdash; None &mdash;</option>
                <% (managers || []).forEach(function(m) { %>
                  <option value="<%= m.employee_id %>" <%= emp.reports_to === m.employee_id ? 'selected' : '' %>><%= m.external_id %> &middot; <%= m.name %></option>
                <% }); %>
              </select>
              <span class="hint">Manager for team view. Active staff only; self excluded. Depth-1 teams.</span>
              <% if (typeof directReports !== 'undefined' && directReports.length) { %>
                <span class="hint" style="color:var(--navy); font-weight:600;">
                  Currently manages: <%= directReports.map(function(d){ return (d.external_id || '') + ' ' + d.name; }).join(', ') %>
                </span>
              <% } %>
            </div>
            <div class="field">
              <label>Team View Role</label>
              <label style="display:flex; align-items:center; gap:10px; font-weight:400; cursor:pointer;">
                <input type="checkbox" name="is_team_leader" style="width:18px; height:18px; accent-color:var(--gold-dark);" <%= (typeof isTeamLeader !== 'undefined' && isTeamLeader) ? 'checked' : '' %>>
                <span>Team Leader &mdash; can view their team's leads</span>
              </label>
              <span class="hint">Assigns the <code>team_leader</code> role. Also grant <code>leads.view_team</code> to that role in the Permission Editor.</span>
            </div>
            <% } %>
          </div>
          <button type="submit" class="btn btn-primary">Save Details</button>
        </form>
      </div>

      <% if (user && user.access_role === 'super_admin') { %>
      <div class="grid2">
        <!-- RESET PASSWORD (BOSS ONLY) -->
        <div class="card danger boss-only">
          <h2>Reset Password &#128273;</h2>
          <div class="sub">Boss-only. Sets a new password for <%= emp.name %>.</div>
          <form action="/admin/employees/<%= emp.employee_id %>/reset-password" method="POST"
                onsubmit="return confirm('Reset password for <%= emp.name %>?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label>New Password</label>
              <input type="text" name="new_password" placeholder="min 6 characters" required>
              <span class="hint">Share securely. They should change it after login.</span>
            </div>
            <button type="submit" class="btn btn-amber">Reset Password</button>
          </form>
        </div>

        <!-- CHANGE ROLE (BOSS ONLY) -->
        <div class="card danger boss-only">
          <h2>Change Permission Level &#128081;</h2>
          <div class="sub">Boss-only. Controls what <%= emp.name %> can access.</div>
          <form action="/admin/employees/<%= emp.employee_id %>/change-role" method="POST"
                onsubmit="return confirm('Change permission level for <%= emp.name %>?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label>Permission Level</label>
              <select name="access_role">
                <option value="employee" <%= emp.access_role === 'employee' ? 'selected' : '' %>>Employee</option>
                <option value="admin" <%= emp.access_role === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="super_admin" <%= emp.access_role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
              </select>
              <span class="hint">Demoting the last super admin is blocked.</span>
            </div>
            <button type="submit" class="btn btn-amber">Update Role</button>
          </form>
        </div>
      </div>
      <% } %>

    </div>
  </div>
</body>
</html>
