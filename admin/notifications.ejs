<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-dark: #B8941F; --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6; --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08); --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .hero-count { position: absolute; top: 26px; right: 32px; z-index: 2; text-align: right; }
    .hero-count .num { font-family: 'Playfair Display', serif; font-size: 40px; font-weight: 700; color: var(--gold); line-height: 1; }
    .hero-count .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(250,250,247,0.6); }
    .group { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); margin-bottom: 18px; overflow: hidden; }
    .group-head { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
    .group-head .gicon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .group-head .gicon svg { width: 20px; height: 20px; }
    .group-head h3 { font-size: 16px; flex: 1; }
    .group-head .gcount { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; }
    .group-head .glink { font-size: 12px; font-weight: 600; text-decoration: none; padding: 6px 12px; border-radius: 8px; background: rgba(10,22,40,0.06); color: var(--navy); }
    .group-head .glink:hover { background: var(--gold); color: var(--navy); }
    .tone-red .gicon { background: rgba(220,38,38,0.12); color: var(--red); } .tone-red .gcount { color: var(--red); }
    .tone-amber .gicon { background: rgba(217,119,6,0.12); color: var(--amber); } .tone-amber .gcount { color: var(--amber); }
    .tone-blue .gicon { background: rgba(37,99,235,0.12); color: var(--blue); } .tone-blue .gcount { color: var(--blue); }
    .tone-green .gicon { background: rgba(22,163,74,0.12); color: var(--green); } .tone-green .gcount { color: var(--green); }
    .alert-row { display: flex; align-items: center; gap: 10px; padding: 12px 20px; border-bottom: 1px solid var(--border); font-size: 13px; }
    .alert-row:last-child { border-bottom: none; }
    .alert-row .who { font-weight: 600; color: var(--navy); min-width: 160px; }
    .alert-row .what { color: var(--muted); flex: 1; }
    .alert-row .when { font-size: 12px; color: var(--muted); }
    .empty-group { padding: 16px 20px; color: var(--muted); font-size: 13px; }
    .all-clear { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 50px; text-align: center; }
    .all-clear .big { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--green); margin-bottom: 6px; }
    .all-clear .sub { color: var(--muted); font-size: 14px; }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <div class="main-content">
    <%- topbarHtml %>
    <div class="page-body">

      <div class="page-hero">
        <h1>Notification Center</h1>
        <p>Live alerts across follow-ups, approvals, hot leads and site visits.</p>
        <div class="hero-count">
          <div class="num"><%= total %></div>
          <div class="lbl">Active Alerts</div>
        </div>
      </div>

      <% if (total === 0) { %>
        <div class="all-clear">
          <div class="big">All clear!</div>
          <div class="sub">No pending alerts right now. Everything is on track.</div>
        </div>
      <% } else { %>
        <% for (var g = 0; g < groups.length; g++) { var grp = groups[g]; if (grp.items.length === 0) continue; %>
          <div class="group tone-<%= grp.tone %>">
            <div class="group-head">
              <div class="gicon">
                <% if (grp.icon === 'overdue') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <% } else if (grp.icon === 'clock') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <% } else if (grp.icon === 'approval') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <% } else if (grp.icon === 'fire') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                <% } else if (grp.icon === 'user') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <% } else if (grp.icon === 'check') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <% } else { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <% } %>
              </div>
              <h3><%= grp.title %></h3>
              <span class="gcount"><%= grp.items.length %></span>
              <a href="<%= grp.link %>" class="glink">View all &rarr;</a>
            </div>
            <% for (var i = 0; i < grp.items.length && i < 6; i++) { var it = grp.items[i]; %>
              <div class="alert-row">
                <% if (grp.key === 'overdue') { %>
                  <span class="who"><%= it.lead_name || 'Lead' %></span>
                  <span class="what"><%= it.next_action || 'Follow-up pending' %></span>
                  <span class="when">due <%= it.next_followup_date ? new Date(it.next_followup_date).toLocaleDateString('en-IN') : '' %></span>
                <% } else if (grp.key === 'due_today') { %>
                  <span class="who"><%= it.lead_name || 'Lead' %></span>
                  <span class="what"><%= it.next_action || 'Follow-up due today' %></span>
                <% } else if (grp.key === 'approvals') { %>
                  <span class="who"><%= it.action_type || 'Action' %></span>
                  <span class="what"><%= it.target_label || '' %> &middot; by <%= it.requested_by_name || 'staff' %></span>
                <% } else if (grp.key === 'hot') { %>
                  <span class="who"><%= it.name || 'Lead' %></span>
                  <span class="what"><%= it.phone || '' %> &middot; <%= it.next_action || 'No next action set' %></span>
                <% } else if (grp.key === 'inactive') { %>
                  <span class="who"><%= it.name || 'Employee' %><%= it.external_id ? ' (' + it.external_id + ')' : '' %></span>
                  <span class="what"><%= it.last_login ? 'Last login ' + new Date(it.last_login).toLocaleDateString('en-IN') : 'Never logged in' %></span>
                <% } else if (grp.key === 'closures') { %>
                  <span class="who"><%= it.name || 'Lead' %></span>
                  <span class="what">Closed as <strong style="color: <%= it.status === 'converted' ? 'var(--green)' : 'var(--red)' %>"><%= it.status || '' %></strong></span>
                  <span class="when"><%= it.closed_at ? new Date(it.closed_at).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) : '' %></span>
                <% } else { %>
                  <span class="who"><%= it.lead_name || 'Lead' %></span>
                  <span class="what">Site visit &middot; <%= it.status || '' %></span>
                  <span class="when"><%= it.scheduled_at ? new Date(it.scheduled_at).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) : '' %></span>
                <% } %>
              </div>
            <% } %>
            <% if (grp.items.length > 6) { %>
              <div class="empty-group">+ <%= grp.items.length - 6 %> more &mdash; <a href="<%= grp.link %>"><%= grp.title.toLowerCase() %></a></div>
            <% } %>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>
</body>
</html>
