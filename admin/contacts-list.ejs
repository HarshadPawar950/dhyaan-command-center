<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
      --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6;
      --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08);
      --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .hero-actions { position: absolute; top: 28px; right: 32px; z-index: 2; }
    .btn { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; padding: 10px 18px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-sm { padding: 6px 10px; font-size: 12px; border-radius: 7px; }
    .btn-edit { background: rgba(37,99,235,0.12); color: var(--blue); }
    .btn-edit:hover { background: var(--blue); color: #fff; }
    .btn-del { background: rgba(220,38,38,0.1); color: var(--red); }
    .btn-del:hover { background: var(--red); color: #fff; }
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 22px; }
    .kpi-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); border-left: 4px solid var(--gold); }
    .kpi-card .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 8px; }
    .kpi-card .value { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--navy); line-height: 1; }
    .flash { background: rgba(22,163,74,0.1); border: 1px solid rgba(22,163,74,0.3); color: var(--green); padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 13px; font-weight: 500; }
    .filter-bar { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 16px 18px; margin-bottom: 18px; }
    .filter-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
    .filter-group { display: flex; flex-direction: column; gap: 4px; }
    .filter-group label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--muted); font-weight: 700; }
    .filter-group input, .filter-group select { font-family: 'Inter', sans-serif; font-size: 13px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--offwhite); min-width: 180px; }
    .panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--muted); padding: 11px 14px; border-bottom: 2px solid var(--border); background: var(--beige); }
    th.ctr, td.ctr { text-align: center; }
    td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    .cname { font-weight: 600; color: var(--navy); }
    .cmeta { font-size: 11px; color: var(--muted); }
    .actions { display: flex; gap: 6px; justify-content: center; }
    .empty { text-align: center; color: var(--muted); padding: 40px; font-size: 14px; }
    .inline-form { display: inline; }
    a.clink { color: var(--blue); text-decoration: none; }
    a.clink:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">

      <div class="page-hero">
        <h1>Contacts</h1>
        <p>Your private builder &amp; broker directory — super-admin only.</p>
        <div class="hero-actions">
          <a href="/admin/contacts/new" class="ds-btn ds-btn-gold"><span style="font-size:18px;line-height:1;">+</span> Add Contact</a>
        </div>
      </div>

      <% if (flash) { %>
        <div class="flash"><%= flash %></div>
      <% } %>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="label">Total Contacts</div>
          <div class="value"><%= totals.total %></div>
        </div>
      </div>

      <div class="filter-bar">
        <form class="filter-form" method="GET" action="/admin/contacts">
          <div class="filter-group">
            <label>Search</label>
            <input type="text" name="q" value="<%= filters.q %>" placeholder="Builder, project, area, phone, email…" />
          </div>
          <div class="filter-group">
            <label>Builder</label>
            <select name="builder">
              <option value="">All builders</option>
              <% builderOpts.forEach(function(v){ %>
                <option value="<%= v %>" <%= filters.builder === v ? 'selected' : '' %>><%= v %></option>
              <% }); %>
            </select>
          </div>
          <div class="filter-group">
            <label>Area</label>
            <select name="area">
              <option value="">All areas</option>
              <% areaOpts.forEach(function(v){ %>
                <option value="<%= v %>" <%= filters.area === v ? 'selected' : '' %>><%= v %></option>
              <% }); %>
            </select>
          </div>
          <button type="submit" class="btn btn-gold">Apply</button>
          <a href="/admin/contacts" class="btn btn-sm" style="background:rgba(10,22,40,0.06);color:var(--muted);">Clear</a>
        </form>
      </div>

      <div class="panel">
        <table>
          <thead>
            <tr>
              <th>Builder</th>
              <th>Project</th>
              <th>Area</th>
              <th>Contact</th>
              <th class="ctr">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (contacts && contacts.length) { %>
              <% contacts.forEach(function(c) { %>
                <tr>
                  <td><span class="cname"><%= c.builder_name %></span><% if (c.contact_person_name || c.designation) { %><div class="cmeta"><%= c.contact_person_name || '' %><% if (c.contact_person_name && c.designation) { %> &middot; <% } %><%= c.designation || '' %></div><% } %></td>
                  <td><%= c.project_name || '—' %></td>
                  <td><%= c.area || '—' %></td>
                  <td>
                    <% if (c.contact_number) { %><div><a class="clink" href="tel:<%= c.contact_number %>"><%= c.contact_number %></a></div><% } %>
                    <% if (c.email) { %><div class="cmeta"><a class="clink" href="mailto:<%= c.email %>"><%= c.email %></a></div><% } %>
                    <% if (c.alt_phone) { %><div class="cmeta">Alt: <a class="clink" href="tel:<%= c.alt_phone %>"><%= c.alt_phone %></a></div><% } %>
                    <% if (c.alt_contact_name || c.alt_contact_phone) { %><div class="cmeta"><%= c.alt_contact_name || '' %><% if (c.alt_contact_phone) { %> &middot; <a class="clink" href="tel:<%= c.alt_contact_phone %>"><%= c.alt_contact_phone %></a><% } %></div><% } %>
                    <% if (!c.contact_number && !c.email && !c.alt_phone && !c.alt_contact_name && !c.alt_contact_phone) { %><span class="cmeta">&mdash;</span><% } %>
                  </td>
                  <td class="ctr">
                    <div class="actions">
                      <a href="/admin/contacts/edit/<%= c.contact_id %>" class="btn btn-sm btn-edit">Edit</a>
                      <form class="inline-form" action="/admin/contacts/delete/<%= c.contact_id %>" method="POST" onsubmit="return confirm('Remove contact &quot;<%= c.builder_name %>&quot;? (soft-delete, recoverable)');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-sm btn-del">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="5" class="empty">No contacts<%= (filters.q || filters.builder || filters.area) ? ' match your filters.' : ' yet. Click “+ Add Contact” to start.' %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
