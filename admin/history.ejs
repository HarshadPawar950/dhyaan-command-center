<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> — Dhyaan Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
            --navy: #0A1628; --navy-2: #142238;
            --offwhite: #FAFAF7; --beige: #F4EFE6;
            --text: #1a1a1a; --muted: #6b6b6b;
            --border: rgba(10, 22, 40, 0.08);
            --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
            --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb; --purple: #7c3aed;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--offwhite); color: var(--text);
            min-height: 100vh; display: flex;
        }
        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
            font-weight: 600; color: var(--navy);
        }
        .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
        .page-body { padding: 26px 40px; flex: 1; }

        .page-hero {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
            color: var(--offwhite); padding: 26px 32px;
            border-radius: 16px; margin-bottom: 22px;
            position: relative; overflow: hidden; box-shadow: var(--shadow);
        }
        .page-hero::before {
            content: ""; position: absolute; top: -50%; right: -10%;
            width: 350px; height: 350px;
            background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%);
            pointer-events: none;
        }
        .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
        .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
        .page-hero .gold-line { display: inline-block; width: 36px; height: 3px; background: var(--gold); margin-top: 12px; border-radius: 2px; }

        .stat-pills {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px; margin-bottom: 22px;
        }
        .stat-pill {
            background: #fff; border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 16px;
            box-shadow: var(--shadow); display: flex; align-items: center; gap: 12px;
        }
        .stat-pill .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .stat-pill.dot-all .dot     { background: var(--gold); }
        .stat-pill.dot-range .dot   { background: var(--blue); }
        .stat-pill.dot-recent .dot  { background: var(--green); }
        .stat-pill.dot-actors .dot  { background: var(--purple); }
        .stat-pill .label {
            font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
            color: var(--muted); font-weight: 600;
        }
        .stat-pill .num {
            font-family: 'Playfair Display', serif; font-size: 22px;
            font-weight: 700; color: var(--navy); line-height: 1;
        }

        .filter-bar {
            background: #fff; border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 18px;
            box-shadow: var(--shadow); margin-bottom: 18px;
        }
        .filter-form {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 100px auto;
            gap: 10px; align-items: end;
        }
        @media (max-width: 1100px) {
            .filter-form { grid-template-columns: 1fr 1fr 1fr; }
        }
        @media (max-width: 700px) {
            .filter-form { grid-template-columns: 1fr; }
        }
        .filter-group { display: flex; flex-direction: column; gap: 5px; }
        .filter-group label {
            font-size: 10px; text-transform: uppercase; letter-spacing: 1px;
            color: var(--muted); font-weight: 600;
        }
        .filter-group input, .filter-group select {
            font-family: inherit; font-size: 13px;
            padding: 9px 12px; border: 1px solid var(--border);
            border-radius: 8px; background: var(--offwhite);
            color: var(--text); outline: none;
        }
        .filter-group input:focus, .filter-group select:focus {
            border-color: var(--gold); background: #fff;
        }
        .filter-actions { display: flex; gap: 8px; }
        .btn {
            display: inline-flex; align-items: center; justify-content: center;
            gap: 6px; padding: 9px 18px; border-radius: 8px;
            font-family: inherit; font-size: 13px; font-weight: 600;
            text-decoration: none; cursor: pointer; border: none;
        }
        .btn-primary { background: var(--navy); color: var(--offwhite); }
        .btn-primary:hover { background: var(--navy-2); }
        .btn-clear { background: transparent; color: var(--muted); border: 1px solid var(--border); }
        .btn-clear:hover { background: var(--beige); color: var(--navy); }

        .active-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
        .chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 5px 10px;
            background: rgba(212,175,55,0.16); color: var(--gold-dark);
            border-radius: 5px; font-size: 11px; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.8px;
        }
        .chip a { color: var(--gold-dark); text-decoration: none; font-size: 14px; line-height: 1; }
        .chip a:hover { color: var(--red); }

        /* TIMELINE */
        .timeline-card {
            background: #fff; border-radius: 14px; border: 1px solid var(--border);
            box-shadow: var(--shadow); overflow: hidden;
        }
        .panel-head {
            padding: 16px 22px; border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
        }
        .panel-head h2 { font-size: 17px; }
        .panel-head .tag {
            font-size: 11px; color: var(--gold-dark); font-weight: 600;
            text-transform: uppercase; letter-spacing: 1px;
        }

        .timeline-item {
            display: grid; grid-template-columns: 40px 1fr auto;
            gap: 14px; align-items: start;
            padding: 16px 22px; border-bottom: 1px solid var(--border);
            transition: background 0.12s ease;
        }
        .timeline-item:hover { background: rgba(212,175,55,0.04); }
        .timeline-item:last-child { border-bottom: none; }

        .action-icon {
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; font-weight: 700;
            color: #fff;
        }
        .icon-assign     { background: var(--gold); color: var(--navy); }
        .icon-reassign   { background: var(--amber); }
        .icon-unassign   { background: var(--red); }
        .icon-create     { background: var(--green); }
        .icon-update     { background: var(--blue); }
        .icon-delete     { background: var(--red); }
        .icon-login      { background: var(--purple); }
        .icon-logout     { background: var(--muted); }
        .icon-toggle     { background: var(--blue); }
        .icon-default    { background: var(--gold-dark); }

        .timeline-body { min-width: 0; }
        .action-title {
            font-size: 14px; color: var(--navy); font-weight: 600;
            margin-bottom: 4px; text-transform: capitalize;
        }
        .action-meta {
            font-size: 12px; color: var(--muted);
            line-height: 1.5; margin-bottom: 4px;
            word-wrap: break-word;
        }
        .action-meta strong { color: var(--navy); font-weight: 600; }
        .diff-row {
            display: inline-flex; align-items: center; gap: 8px;
            margin-top: 4px; font-size: 12px;
            background: var(--beige); padding: 4px 10px; border-radius: 6px;
        }
        .diff-old { color: var(--red); text-decoration: line-through; opacity: 0.7; }
        .diff-arrow { color: var(--muted); }
        .diff-new { color: var(--green); font-weight: 600; }
        .empty-diff { color: var(--muted); font-style: italic; }

        .entity-badge {
            display: inline-block;
            font-size: 9px; text-transform: uppercase; letter-spacing: 1px;
            padding: 2px 7px; border-radius: 4px; font-weight: 700;
            margin-right: 4px;
        }
        .entity-lead     { background: rgba(220,38,38,0.10);  color: var(--red); }
        .entity-employee { background: rgba(124,58,237,0.10); color: var(--purple); }
        .entity-property { background: rgba(22,163,74,0.10);  color: var(--green); }
        .entity-session  { background: rgba(37,99,235,0.10);  color: var(--blue); }
        .entity-default  { background: var(--beige); color: var(--navy); }

        .timeline-right {
            text-align: right;
            font-size: 11px; color: var(--muted);
            min-width: 140px;
        }
        .timeline-date {
            color: var(--navy); font-weight: 600; font-size: 12px;
            margin-bottom: 2px;
        }
        .actor-pill {
            display: inline-flex; align-items: center; gap: 5px;
            margin-top: 4px; padding: 3px 8px; border-radius: 999px;
            background: var(--beige); font-size: 10px;
            font-weight: 600; color: var(--navy);
        }
        .actor-pill .actor-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }

        .empty-state {
            padding: 60px 24px; text-align: center;
            color: var(--muted); font-size: 14px;
        }
        .empty-state .big-emoji { font-size: 36px; margin-bottom: 8px; }

        @media (max-width: 800px) {
            .timeline-item { grid-template-columns: 32px 1fr; }
            .action-icon { width: 30px; height: 30px; font-size: 12px; }
            .timeline-right { grid-column: 1 / -1; text-align: left; padding-left: 46px; }
        }
    </style>
</head>
<body>

    <%- include('./layout/sidebar') %>

    <div class="main-content">
        <%- include('./layout/topbar') %>

        <div class="page-body">

            <div class="page-hero">
                <h1>Change History</h1>
                <p>Every change, every action — fully audited. Who did what, when, and why.</p>
                <div class="gold-line"></div>
            </div>

            <!-- STATS -->
            <div class="stat-pills">
                <div class="stat-pill dot-all">
                    <div class="dot"></div>
                    <div><div class="label">All Time</div><div class="num"><%= stats.total_all_time %></div></div>
                </div>
                <div class="stat-pill dot-range">
                    <div class="dot"></div>
                    <div><div class="label">Last <%= filters.days %>d</div><div class="num"><%= stats.in_range %></div></div>
                </div>
                <div class="stat-pill dot-recent">
                    <div class="dot"></div>
                    <div><div class="label">Last 24h</div><div class="num"><%= stats.last_24h %></div></div>
                </div>
                <div class="stat-pill dot-actors">
                    <div class="dot"></div>
                    <div><div class="label">Distinct Actors</div><div class="num"><%= stats.distinct_actors %></div></div>
                </div>
            </div>

            <!-- FILTERS -->
            <div class="filter-bar">
                <form method="GET" action="/admin/history" class="filter-form">
                    <div class="filter-group">
                        <label>Search</label>
                        <input type="text" name="q" placeholder="Search notes, fields, values..." value="<%= filters.q %>" />
                    </div>
                    <div class="filter-group">
                        <label>Entity</label>
                        <select name="entity">
                            <option value="">All</option>
                            <% entityTypes.forEach(function(e) { %>
                                <option value="<%= e %>" <%= filters.entity === e.toLowerCase() ? 'selected' : '' %>><%= e %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Action</label>
                        <select name="action">
                            <option value="">All</option>
                            <% actions.forEach(function(a) { %>
                                <option value="<%= a %>" <%= filters.action === a.toLowerCase() ? 'selected' : '' %>><%= a.replace(/_/g, ' ') %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Actor</label>
                        <select name="actor">
                            <option value="">All</option>
                            <% actors.forEach(function(a) { %>
                                <option value="<%= a.changed_by_code %>" <%= filters.actor === a.changed_by_code ? 'selected' : '' %>>
                                    <%= a.changed_by_name %> (<%= a.changed_by_code %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Days</label>
                        <select name="days">
                            <option value="1"   <%= filters.days === 1   ? 'selected' : '' %>>1</option>
                            <option value="7"   <%= filters.days === 7   ? 'selected' : '' %>>7</option>
                            <option value="30"  <%= filters.days === 30  ? 'selected' : '' %>>30</option>
                            <option value="90"  <%= filters.days === 90  ? 'selected' : '' %>>90</option>
                            <option value="365" <%= filters.days === 365 ? 'selected' : '' %>>365</option>
                        </select>
                    </div>
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary">Apply</button>
                        <a href="/admin/history" class="btn btn-clear">Clear</a>
                    </div>
                </form>
            </div>

            <!-- ACTIVE FILTER CHIPS -->
            <%
                const activeFilters = [];
                if (filters.q)      activeFilters.push({ k: 'q',      v: 'Search: ' + filters.q });
                if (filters.entity) activeFilters.push({ k: 'entity', v: 'Entity: ' + filters.entity });
                if (filters.action) activeFilters.push({ k: 'action', v: 'Action: ' + filters.action });
                if (filters.actor)  activeFilters.push({ k: 'actor',  v: 'Actor: ' + filters.actor });

                function buildQS(skip) {
                    const parts = [];
                    if (filters.q      && skip !== 'q')      parts.push('q=' + encodeURIComponent(filters.q));
                    if (filters.entity && skip !== 'entity') parts.push('entity=' + encodeURIComponent(filters.entity));
                    if (filters.action && skip !== 'action') parts.push('action=' + encodeURIComponent(filters.action));
                    if (filters.actor  && skip !== 'actor')  parts.push('actor=' + encodeURIComponent(filters.actor));
                    if (filters.days !== 30)                 parts.push('days=' + filters.days);
                    return parts.length ? '/admin/history?' + parts.join('&') : '/admin/history';
                }
            %>
            <% if (activeFilters.length > 0) { %>
                <div class="active-filters">
                    <% activeFilters.forEach(function(af) { %>
                        <span class="chip"><%= af.v %> <a href="<%= buildQS(af.k) %>">✕</a></span>
                    <% }); %>
                </div>
            <% } %>

            <!-- TIMELINE -->
            <div class="timeline-card">
                <div class="panel-head">
                    <h2>Activity Timeline</h2>
                    <span class="tag"><%= showing %> entries</span>
                </div>

                <% if (entries && entries.length > 0) { %>
                    <% entries.forEach(function(h) { %>
                        <%
                            const act = (h.action || '').toLowerCase();
                            let icon = 'icon-default'; let glyph = '•';
                            if (act === 'assign')        { icon = 'icon-assign';   glyph = '→'; }
                            else if (act === 'reassign') { icon = 'icon-reassign'; glyph = '↻'; }
                            else if (act === 'unassign') { icon = 'icon-unassign'; glyph = '✕'; }
                            else if (act === 'create')   { icon = 'icon-create';   glyph = '+'; }
                            else if (act === 'update')   { icon = 'icon-update';   glyph = '✎'; }
                            else if (act === 'delete')   { icon = 'icon-delete';   glyph = '✕'; }
                            else if (act === 'login')    { icon = 'icon-login';    glyph = '⌂'; }
                            else if (act === 'logout')   { icon = 'icon-logout';   glyph = '⌂'; }
                            else if (act.indexOf('toggle') >= 0 || act.indexOf('status') >= 0) { icon = 'icon-toggle'; glyph = '⇄'; }

                            const ent = (h.entity_type || '').toLowerCase();
                            let entCls = 'entity-default';
                            if (ent === 'lead')     entCls = 'entity-lead';
                            else if (ent === 'employee') entCls = 'entity-employee';
                            else if (ent === 'property') entCls = 'entity-property';
                            else if (ent === 'session' || ent === 'auth') entCls = 'entity-session';
                        %>
                        <div class="timeline-item">
                            <div class="action-icon <%= icon %>"><%= glyph %></div>
                            <div class="timeline-body">
                                <div class="action-title">
                                    <%= (h.action || 'event').replace(/_/g, ' ') %>
                                    <% if (h.field_name) { %> · <%= h.field_name %><% } %>
                                </div>
                                <div class="action-meta">
                                    <% if (h.entity_type) { %>
                                        <span class="entity-badge <%= entCls %>"><%= h.entity_type %></span>
                                    <% } %>
                                    <% if (h.entity_id) { %>
                                        <strong><%= h.entity_id %></strong>
                                    <% } %>
                                    <% if (h.notes) { %>
                                        <br/><%= h.notes %>
                                    <% } %>
                                </div>
                                <% if ((h.old_value || h.new_value) && !h.notes) { %>
                                    <div class="diff-row">
                                        <% if (h.old_value) { %>
                                            <span class="diff-old"><%= h.old_value %></span>
                                        <% } else { %>
                                            <span class="empty-diff">(empty)</span>
                                        <% } %>
                                        <span class="diff-arrow">→</span>
                                        <% if (h.new_value) { %>
                                            <span class="diff-new"><%= h.new_value %></span>
                                        <% } else { %>
                                            <span class="empty-diff">(cleared)</span>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="timeline-right">
                                <div class="timeline-date">
                                    <%= h.created_at ? new Date(h.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>
                                </div>
                                <div>
                                    <%= h.created_at ? new Date(h.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) : '' %>
                                </div>
                                <% if (h.changed_by_name) { %>
                                    <div class="actor-pill">
                                        <span class="actor-dot"></span>
                                        <%= h.changed_by_name %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <div class="big-emoji">📜</div>
                        <div>No activity yet in this date range.</div>
                        <div style="margin-top: 8px; font-size: 12px;">Try expanding the days filter or clearing other filters.</div>
                    </div>
                <% } %>
            </div>

        </div>
    </div>

</body>
</html>
