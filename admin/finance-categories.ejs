<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --gold-dark:#B8941F; --navy:#0A1628; --navy-2:#142238; --offwhite:#FAFAF7; --beige:#F4EFE6; --text:#1a1a1a; --muted:#6b6b6b; --border:rgba(10,22,40,0.08); --shadow:0 4px 24px rgba(10,22,40,0.06); --green:#16a34a; --red:#dc2626; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--offwhite); color:var(--text); min-height:100vh; display:flex; }
    h1,h2,h3 { font-family:'Playfair Display',serif; font-weight:600; color:var(--navy); }
    .main-content { flex:1; margin-left:260px; min-height:100vh; display:flex; flex-direction:column; }
    .page-body { padding:28px 40px; flex:1; max-width:1000px; }
    .page-hero { background:linear-gradient(135deg,var(--navy) 0%,var(--navy-2) 100%); color:var(--offwhite); padding:24px 30px; border-radius:16px; margin-bottom:22px; box-shadow:var(--shadow); position:relative; }
    .page-hero h1 { color:var(--offwhite); font-size:26px; margin-bottom:4px; }
    .page-hero p { color:rgba(250,250,247,0.7); font-size:14px; }
    .hero-actions { position:absolute; top:26px; right:30px; }
    .err { background:rgba(220,38,38,0.1); border:1px solid rgba(220,38,38,0.3); color:var(--red); padding:12px 18px; border-radius:10px; margin-bottom:18px; font-size:13px; font-weight:500; }
    .flash { background:rgba(22,163,74,0.1); border:1px solid rgba(22,163,74,0.3); color:var(--green); padding:12px 18px; border-radius:10px; margin-bottom:18px; font-size:13px; font-weight:500; }
    .panel { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:var(--shadow); padding:20px 24px; margin-bottom:20px; }
    .panel h3 { font-size:16px; margin-bottom:14px; }
    .row { display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; }
    .fg { display:flex; flex-direction:column; gap:4px; }
    .fg label { font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); font-weight:700; }
    .fg input[type=text], .fg input[type=number] { font-size:13px; padding:8px 10px; border:1px solid var(--border); border-radius:8px; background:var(--offwhite); }
    .chk { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--muted); }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); padding:10px 12px; border-bottom:2px solid var(--border); background:var(--beige); }
    th.ctr, td.ctr { text-align:center; }
    td { padding:10px 12px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .btn { font-family:'Inter',sans-serif; font-size:13px; font-weight:600; padding:9px 16px; border-radius:8px; border:none; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
    .btn-gold { background:var(--gold); color:var(--navy); } .btn-gold:hover { background:var(--gold-dark); color:#fff; }
    .btn-ghost { background:rgba(10,22,40,0.06); color:var(--muted); }
    .btn-sm { padding:6px 10px; font-size:12px; }
    .btn-del { background:rgba(220,38,38,0.1); color:var(--red); } .btn-del:hover { background:var(--red); color:#fff; }
    .inline-form { display:inline; } .used { color:var(--muted); font-size:11px; }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <div class="main-content">
    <%- topbarHtml %>
    <div class="page-body">
      <div class="page-hero">
        <h1>Expense Categories</h1>
        <p>Managed category master. Input-GST flag feeds the GST summary.</p>
        <div class="hero-actions"><a href="/admin/finance/expenses" class="btn btn-ghost">← Expenses</a></div>
      </div>

      <% if (flash) { %><div class="flash"><%= flash %></div><% } %>
      <% if (err) { %><div class="err"><%= err %></div><% } %>

      <div class="panel">
        <h3>Add Category</h3>
        <form class="row" action="/admin/finance/categories/new" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="fg"><label>Name</label><input type="text" name="name" required maxlength="120" placeholder="e.g. Legal Fees" /></div>
          <div class="fg"><label>Sort</label><input type="number" name="sort_order" value="100" style="width:80px" /></div>
          <label class="chk"><input type="checkbox" name="is_input_gst_eligible" /> Input-GST eligible</label>
          <button type="submit" class="btn btn-gold">+ Add</button>
        </form>
      </div>

      <div class="panel">
        <h3>Categories (<%= categories.length %>)</h3>
        <table>
          <thead><tr><th>Name</th><th class="ctr">Sort</th><th class="ctr">Input-GST</th><th class="ctr">Active</th><th class="ctr">Used</th><th class="ctr">Save</th><th class="ctr">Remove</th></tr></thead>
          <tbody>
            <% categories.forEach(function(c){ %>
              <tr>
                <form class="inline-form" action="/admin/finance/categories/edit/<%= c.category_id %>" method="POST" id="cat-<%= c.category_id %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <td><input type="text" name="name" value="<%= c.name %>" maxlength="120" style="width:220px;padding:7px 9px;border:1px solid var(--border);border-radius:7px;background:var(--offwhite);font-size:13px;" /></td>
                  <td class="ctr"><input type="number" name="sort_order" value="<%= c.sort_order %>" style="width:64px;padding:7px;border:1px solid var(--border);border-radius:7px;background:var(--offwhite);font-size:13px;text-align:center;" /></td>
                  <td class="ctr"><input type="checkbox" name="is_input_gst_eligible" <%= c.is_input_gst_eligible?'checked':'' %> /></td>
                  <td class="ctr"><input type="checkbox" name="active" <%= c.active?'checked':'' %> /></td>
                  <td class="ctr used"><%= c.used %></td>
                  <td class="ctr"><button type="submit" class="btn btn-sm btn-ghost">Save</button></td>
                </form>
                <td class="ctr">
                  <form class="inline-form" action="/admin/finance/categories/delete/<%= c.category_id %>" method="POST" onsubmit="return confirm('Remove category &quot;<%= c.name %>&quot;?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-sm btn-del" <%= c.used>0?'disabled title=\"in use\"':'' %>>Del</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
