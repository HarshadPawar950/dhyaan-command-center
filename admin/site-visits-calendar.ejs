<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --navy:#0A1628; --navy-2:#142238; --offwhite:#FAFAF7; --beige:#F4EFE6; --muted:#6b6b6b; --border:rgba(10,22,40,0.08); --shadow:0 4px 24px rgba(10,22,40,0.06); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--offwhite); color:#1a1a1a; min-height:100vh; display:flex; }
    h1,h2 { font-family:'Playfair Display',serif; color:var(--navy); }
    .main-content { flex:1; margin-left:260px; min-height:100vh; display:flex; flex-direction:column; }
    .page-body { padding:28px 40px; flex:1; }
    .page-hero { background:linear-gradient(135deg,var(--navy),var(--navy-2)); color:var(--offwhite); padding:22px 30px; border-radius:16px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; box-shadow:var(--shadow); }
    .page-hero h1 { color:var(--offwhite); font-size:24px; }
    .page-hero p { color:rgba(250,250,247,0.7); font-size:13px; margin-top:3px; }
    .toolbar { display:flex; align-items:center; gap:10px; }
    .toolbar a, .toolbar button { text-decoration:none; font-size:13px; font-weight:600; padding:8px 14px; border-radius:8px; border:none; cursor:pointer; }
    .toolbar .nav { background:rgba(255,255,255,0.15); color:var(--offwhite); }
    .toolbar input[type=month] { padding:7px 10px; border-radius:8px; border:1px solid rgba(212,175,55,0.4); font-size:13px; }
    .toolbar .go { background:var(--gold); color:var(--navy); }
    .toolbar .list { background:var(--offwhite); color:var(--navy); }
    .cal { width:100%; border-collapse:collapse; background:#fff; border-radius:14px; overflow:hidden; box-shadow:var(--shadow); }
    .cal th { background:var(--beige); color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.5px; padding:10px; text-align:left; border-bottom:2px solid var(--border); }
    .cal td { border:1px solid var(--border); vertical-align:top; height:112px; width:14.28%; padding:6px; }
    .cal td.pad { background:#fbfaf7; }
    .daynum { font-size:12px; font-weight:700; color:var(--navy); margin-bottom:5px; }
    .daynum.today { background:var(--gold); color:var(--navy); border-radius:6px; padding:1px 6px; display:inline-block; }
    /* status colours: scheduled/confirmed=navy, completed=green, booked=gold,
       cancelled=grey, no_show=red */
    .chip { display:block; text-decoration:none; font-size:11px; line-height:1.25; padding:4px 6px; border-radius:6px; margin-bottom:4px; background:rgba(10,22,40,0.06); border-left:3px solid var(--navy); color:var(--navy); }
    .chip:hover { filter:brightness(0.97); }
    .chip .ex { font-weight:700; }
    .chip .who { color:var(--muted); }
    .chip.scheduled, .chip.confirmed { border-left-color:var(--navy); background:rgba(10,22,40,0.06); }
    .chip.completed { border-left-color:#16a34a; background:rgba(22,163,74,0.12); }
    .chip.booked    { border-left-color:var(--gold); background:rgba(212,175,55,0.18); }
    .chip.cancelled { border-left-color:#9ca3af; background:rgba(156,163,175,0.14); color:#6b7280; }
    .chip.no_show   { border-left-color:#dc2626; background:rgba(220,38,38,0.10); }
    .empty-note { text-align:center; color:var(--muted); font-style:italic; padding:20px; }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">
      <%
        const [Y, M] = month.split('-').map(Number);
        const prev = M === 1 ? `${Y-1}-12` : `${Y}-${String(M-1).padStart(2,'0')}`;
        const next = M === 12 ? `${Y+1}-01` : `${Y}-${String(M+1).padStart(2,'0')}`;
        const label = new Date(Y, M-1, 1).toLocaleDateString('en-IN', { month:'long', year:'numeric' });
        const todayStr = new Date().toISOString().slice(0,10);
      %>
      <div class="page-hero">
        <div>
          <h1>Site Visit Calendar</h1>
          <p><%= label %> &middot; <%= totalVisits %> visit<%= totalVisits === 1 ? '' : 's' %></p>
        </div>
        <form class="toolbar" method="get" action="/admin/site-visits/calendar">
          <a class="nav" href="/admin/site-visits/calendar?month=<%= prev %>">&larr;</a>
          <input type="month" name="month" value="<%= month %>" max="2100-12">
          <button class="go" type="submit">Go</button>
          <a class="nav" href="/admin/site-visits/calendar?month=<%= next %>">&rarr;</a>
          <a class="list" href="/admin/site-visits">List view</a>
        </form>
      </div>

      <div class="cal-scroll">
      <table class="cal">
        <thead><tr><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th></tr></thead>
        <tbody>
          <% weeks.forEach(function(week) { %>
            <tr>
              <% week.forEach(function(cell) { %>
                <% if (cell.day === null) { %>
                  <td class="pad"></td>
                <% } else { %>
                  <td>
                    <div class="daynum <%= cell.ds === todayStr ? 'today' : '' %>"><%= cell.day %></div>
                    <% cell.visits.forEach(function(v) {
                         const scls = ['scheduled','confirmed','completed','no_show','cancelled','booked'].includes(v.status) ? v.status : '';
                         const execShort = v.exec_name ? v.exec_name.split(' ')[0] : 'Unassigned';
                    %>
                      <a class="chip <%= scls %>" href="/admin/site-visits/<%= v.visit_id %>" title="<%= v.t %> · <%= v.lead_name %> → <%= v.property_title %> (<%= v.status %>) · <%= v.exec_name || 'unassigned' %>">
                        <span class="ex"><%= execShort %></span> · <%= v.lead_name %>
                      </a>
                    <% }); %>
                  </td>
                <% } %>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</body>
</html>
