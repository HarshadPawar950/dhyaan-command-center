<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-dark: #B8941F; --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6; --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08); --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); }
    .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .btn { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; padding: 10px 18px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-ghost { background: rgba(10,22,40,0.06); color: var(--navy); }
    .flash { background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.3); color: var(--red); padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 13px; font-weight: 500; }
    .form-panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 28px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field.full { grid-column: 1 / -1; }
    label { font-size: 12px; font-weight: 600; color: var(--navy); text-transform: uppercase; letter-spacing: 0.3px; }
    label .req { color: var(--red); }
    input[type=text], input[type=date], select, textarea { font-family: 'Inter', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--offwhite); color: var(--text); width: 100%; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); background: #fff; }
    textarea { resize: vertical; min-height: 70px; }
    .form-actions { display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <div class="main-content">
    <%- topbarHtml %>
    <div class="page-body">
      <%- include('../partials/breadcrumb', { crumbs:[{label:'Follow-Ups',href:'/admin/follow-ups'},{label:'New Follow-Up'}], backHref:'/admin/follow-ups' }) %>

      <div class="page-hero">
        <h1>Log Follow-Up</h1>
        <p>Record what happened and set the next action + date for this lead.</p>
      </div>

      <div class="form-panel">
        <form action="/admin/follow-ups/new" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-grid">
            <div class="field full">
              <label>Lead <span class="req">*</span></label>
              <select name="lead_id" required>
                <option value="">-- Select a lead --</option>
                <% for (var i = 0; i < leads.length; i++) { %>
                  <option value="<%= leads[i].lead_id %>" <%= preLead === leads[i].lead_id ? 'selected' : '' %>>
                    <%= leads[i].name %> (<%= leads[i].phone || 'no phone' %>) &middot; <%= leads[i].status %>
                  </option>
                <% } %>
              </select>
            </div>
            <div class="field full">
              <label>Action Taken</label>
              <textarea name="action_taken" placeholder="e.g. Called, discussed budget and possession timeline"></textarea>
            </div>
            <div class="field">
              <label>Next Action</label>
              <input type="text" name="next_action" placeholder="e.g. Schedule site visit at Kharghar" />
            </div>
            <div class="field">
              <label>Next Follow-Up Date</label>
              <input type="date" name="next_followup_date" />
            </div>
            <div class="field">
              <label>Outcome</label>
              <select name="outcome">
                <option value="pending">Pending (needs follow-up)</option>
                <option value="completed">Completed</option>
                <option value="rescheduled">Rescheduled</option>
              </select>
            </div>
            <div class="field full">
              <label>Notes</label>
              <textarea name="notes" placeholder="Any extra context..."></textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-gold">Save Follow-Up</button>
            <a href="/admin/follow-ups" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>

    </div>
  </div>
</body>
</html>
