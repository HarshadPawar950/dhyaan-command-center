<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --gold: #D4AF37; --gold-dark: #B8941F; --navy: #0A1628; --navy-2: #142238;
      --offwhite: #FAFAF7; --beige: #F4EFE6; --text: #1a1a1a; --muted: #6b6b6b;
      --border: rgba(10, 22, 40, 0.08); --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
      --red: #dc2626;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; display: flex; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
    .main-content { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }
    .page-body { padding: 28px 40px; flex: 1; max-width: 900px; }
    .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 24px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .page-hero h1 { color: var(--offwhite); font-size: 26px; margin-bottom: 4px; }
    .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
    .err { background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.3); color: var(--red); padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 13px; font-weight: 500; }
    .form-panel { background: #fff; border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); padding: 28px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field.full { grid-column: 1 / -1; }
    label { font-size: 12px; font-weight: 600; color: var(--navy); text-transform: uppercase; letter-spacing: 0.3px; }
    label .req { color: var(--red); }
    input[type=text], input[type=email], input[type=tel], input[type=number], input[type=date], select, textarea {
      font-family: 'Inter', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--offwhite); color: var(--text); width: 100%;
    }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); background: #fff; }
    textarea { resize: vertical; min-height: 70px; }
    .checkrow { display: flex; align-items: center; gap: 10px; padding-top: 8px; }
    .checkrow input { width: 18px; height: 18px; accent-color: var(--gold); }
    .checkrow label { text-transform: none; letter-spacing: 0; font-weight: 500; }
    .hint { font-size: 11px; color: var(--muted); }
    .form-actions { display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }
    .btn { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; padding: 11px 22px; border-radius: 9px; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--beige); }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">
      <%- include('../partials/breadcrumb', { crumbs:[{label:'Builders',href:'/admin/builders'},{label:'Add Builder'}], backHref:'/admin/builders' }) %>

      <div class="page-hero">
        <h1>Add Builder</h1>
        <p>Create a new developer record with RERA, GST &amp; commission terms.</p>
      </div>

      <% if (typeof query !== 'undefined' && query && query.err) { %>
        <div class="err"><%= query.err %></div>
      <% } %>

      <div class="form-panel">
        <form action="/admin/builders/new" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-grid">

            <div class="field full">
              <label>Builder / Developer Name <span class="req">*</span></label>
              <input type="text" name="name" required placeholder="e.g. Paradise Group" />
            </div>

            <div class="field">
              <label>RERA Number</label>
              <input type="text" name="rera_number" placeholder="e.g. P51700012345" />
            </div>
            <div class="field">
              <label>GST Number</label>
              <input type="text" name="gst_number" placeholder="e.g. 27ABCDE1234F1Z5" />
            </div>

            <div class="field">
              <label>Contact Person</label>
              <input type="text" name="contact_person" placeholder="Name" />
            </div>
            <div class="field">
              <label>Phone</label>
              <input type="tel" name="phone" placeholder="Mobile / landline" />
            </div>

            <div class="field full">
              <label>Email</label>
              <input type="email" name="email" placeholder="builder@example.com" />
            </div>

            <div class="field">
              <label>Commission Type</label>
              <select name="commission_type">
                <% commissionTypes.forEach(function(ct) { %>
                  <option value="<%= ct %>"><%= ct.charAt(0).toUpperCase() + ct.slice(1) %></option>
                <% }); %>
              </select>
              <span class="hint">percentage = %, flat = fixed ₹, slab = tiered</span>
            </div>
            <div class="field">
              <label>Commission Rate</label>
              <input type="number" step="0.01" min="0" name="commission_rate" value="0" />
              <span class="hint">% value, flat ₹ amount, or slab base</span>
            </div>

            <div class="field">
              <label>Payment Terms</label>
              <input type="text" name="payment_terms" placeholder="e.g. on registration" />
            </div>
            <div class="field">
              <label>Tie-up Date</label>
              <input type="date" name="tie_up_date" />
            </div>

            <div class="field full">
              <div class="checkrow">
                <input type="checkbox" id="is_exclusive" name="is_exclusive" />
                <label for="is_exclusive">Exclusive tie-up with Dhyaan</label>
              </div>
            </div>

            <div class="field full">
              <label>Notes</label>
              <textarea name="notes" placeholder="Agreement terms, special arrangements..."></textarea>
            </div>

          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-gold">Save Builder</button>
            <a href="/admin/builders" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>

    </div>
  </div>
</body>
</html>
