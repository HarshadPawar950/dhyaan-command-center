<%
// =============================================================
// views/admin/layout/topbar.ejs
// Top bar with page title, user identity, role badge, logout.
// Expects: pageTitle (string), user ({ name, role, ... })
// =============================================================
const _role = (user && user.role) ? user.role : 'employee';
const _name = (user && user.name) ? user.name : 'User';
const _initial = _name.charAt(0).toUpperCase();
const _roleLabel = _role === 'super_admin' ? 'Super Admin'
                : _role === 'admin'       ? 'Admin'
                : 'Employee';
const _badgeClass = _role === 'super_admin' ? 'role-super' : 'role-admin';
%>
<!-- Shared design-system primitives (see sidebar.ejs). Same URL → browser
     dedupes the fetch; ds- namespaced so no admin styles change. -->
<link rel="stylesheet" href="/css/design-system.css">
<style>
    .admin-topbar {
        background: #fff;
        border-bottom: 1px solid rgba(10, 22, 40, 0.06);
        padding: 16px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: 0 1px 3px rgba(10, 22, 40, 0.04);
    }
    .admin-topbar .title-cluster {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .admin-topbar .topbar-hamburger {
        background: transparent;
        border: none;
        cursor: pointer;
        color: #0A1628;
        padding: 5px;
        display: inline-flex;
        border-radius: 8px;
        transition: background 0.15s ease;
    }
    .admin-topbar .topbar-hamburger svg { width: 22px; height: 22px; }
    .admin-topbar .topbar-hamburger:hover { background: rgba(10, 22, 40, 0.06); }
    .admin-topbar .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        color: #0A1628;
        font-weight: 600;
        letter-spacing: -0.3px;
    }
    .admin-topbar .user-chevron {
        width: 16px; height: 16px;
        color: #6b6b6b;
        opacity: 0.55;
        flex-shrink: 0;
    }
    .admin-topbar .right-cluster {
        display: flex;
        align-items: center;
        gap: 18px;
    }
    .admin-topbar .user-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .admin-topbar .avatar {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #D4AF37 0%, #E8C766 100%);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: #0A1628;
        font-size: 16px;
    }
    .admin-topbar .user-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .admin-topbar .user-name {
        font-size: 14px;
        font-weight: 600;
        color: #0A1628;
        line-height: 1.1;
    }
    .admin-topbar .role-badge {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
        width: fit-content;
    }
    .admin-topbar .role-admin {
        background: rgba(212, 175, 55, 0.16);
        color: #B8941F;
    }
    .admin-topbar .role-super {
        background: linear-gradient(135deg, #D4AF37 0%, #E8C766 100%);
        color: #0A1628;
    }
    .admin-topbar .logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: transparent;
        border: 1px solid rgba(10, 22, 40, 0.12);
        border-radius: 8px;
        color: #0A1628;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.15s ease;
        cursor: pointer;
    }
    .admin-topbar .logout-btn:hover {
        background: #0A1628;
        color: #FAFAF7;
        border-color: #0A1628;
    }
    .admin-topbar .logout-btn svg {
        width: 14px; height: 14px;
    }

    @media (max-width: 700px) {
        .admin-topbar { padding: 14px 20px; }
        .admin-topbar .page-title { font-size: 18px; }
        .admin-topbar .user-meta { display: none; }
    }
</style>

<header class="admin-topbar">

    <div class="title-cluster">
        <button class="topbar-hamburger" type="button" aria-label="Toggle navigation" onclick="document.body.classList.toggle('nav-open')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <div class="page-title"><%= pageTitle || 'Admin' %></div>
    </div>

    <div class="right-cluster">
        <div class="user-block">
            <div class="avatar"><%= _initial %></div>
            <div class="user-meta">
                <span class="user-name"><%= _name %></span>
                <span class="role-badge <%= _badgeClass %>"><%= _roleLabel %></span>
            </div>
            <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </div>

        <a href="/logout" class="logout-btn" title="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Logout
        </a>
    </div>

</header>
