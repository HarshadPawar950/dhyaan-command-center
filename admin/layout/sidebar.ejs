<%
// =============================================================
// views/admin/layout/sidebar.ejs
// CANONICAL admin nav sidebar — single source of truth for every
// admin view (rendered via renderPartial('sidebar') or include).
// Common items visible to all admins; Super Admin group gated.
// Expects: pageTitle (string), user (session user object)
// =============================================================
const currentPath = (locals && locals.currentPath) ? locals.currentPath : '';
const _pt = (pageTitle || '').toLowerCase();
function isActive(label) { return _pt.includes(label.toLowerCase()); }
const _isSuper = !!(user && (user.access_role === 'super_admin' || user.role === 'super_admin'));
// Live permission set attached by the global middleware (non-enumerable on the
// session user). canSee() hides an item the viewer's tier can't open, so the
// nav never shows a link that 403s. Fails OPEN if perms are absent (super, or a
// transient nav-compute miss) — routes still enforce access regardless.
const _navPerms = (user && user.navPerms) ? user.navPerms : null;
function canSee(key) {
    if (_isSuper) return true;
    if (!_navPerms) return true;
    return _navPerms.indexOf('*') !== -1 || _navPerms.indexOf(key) !== -1;
}
%>
<!-- Shared design-system primitives for all admin pages (ds- namespaced;
     does not alter existing admin styles). -->
<link rel="stylesheet" href="/css/design-system.css">
<style>
    .admin-sidebar {
        position: fixed;
        top: 0; left: 0;
        width: 260px;
        height: 100vh;
        background: linear-gradient(180deg, #0A1628 0%, #142238 100%);
        color: #FAFAF7;
        display: flex;
        flex-direction: column;
        z-index: 100;
        box-shadow: 2px 0 24px rgba(0,0,0,0.08);
    }
    .admin-sidebar .brand {
        padding: 22px 24px 20px;
        border-bottom: 1px solid rgba(212, 175, 55, 0.18);
        display: flex;
        justify-content: center;
        flex-shrink: 0;
    }
    .admin-sidebar .brand-logo-img {
        height: 84px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        display: block;
    }
    .admin-sidebar .nav-group-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.6px;
        color: rgba(250, 250, 247, 0.4);
        padding: 18px 24px 8px;
        font-weight: 600;
    }
    .admin-sidebar .nav-list {
        list-style: none;
        padding: 0; margin: 0;
        overflow-y: auto;
        flex: 1;
    }
    .admin-sidebar .nav-list::-webkit-scrollbar {
        width: 6px;
    }
    .admin-sidebar .nav-list::-webkit-scrollbar-track {
        background: transparent;
    }
    .admin-sidebar .nav-list::-webkit-scrollbar-thumb {
        background: rgba(212, 175, 55, 0.45);
        border-radius: 999px;
    }
    .admin-sidebar .nav-list::-webkit-scrollbar-thumb:hover {
        background: rgba(212, 175, 55, 0.75);
    }
    .admin-sidebar .nav-list {
        scrollbar-width: thin;
        scrollbar-color: rgba(212, 175, 55, 0.45) transparent;
    }
    .admin-sidebar .nav-item a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 24px;
        color: rgba(250, 250, 247, 0.78);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: all 0.15s ease;
    }
    .admin-sidebar .nav-item a:hover {
        background: rgba(212, 175, 55, 0.08);
        color: #FAFAF7;
        border-left-color: rgba(212, 175, 55, 0.4);
    }
    .admin-sidebar .nav-item.active a {
        background: rgba(212, 175, 55, 0.14);
        color: #FAFAF7;
        border-left-color: #D4AF37;
    }
    .admin-sidebar .nav-item .icon {
        width: 18px; height: 18px;
        opacity: 0.85;
        flex-shrink: 0;
    }
    .admin-sidebar .nav-item .soon-tag {
        margin-left: auto;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1px;
        background: rgba(212, 175, 55, 0.18);
        color: #D4AF37;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
    }
    .admin-sidebar .side-card {
        margin: 14px;
        border-radius: 12px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(212, 175, 55, 0.18);
        flex-shrink: 0;
    }
    .admin-sidebar .side-card-img {
        height: 78px;
        background: url('/img/building-strip.png') center / cover no-repeat;
    }
    .admin-sidebar .side-card-body { padding: 12px 15px 14px; }
    .admin-sidebar .side-card-title {
        font-family: 'Playfair Display', serif;
        font-size: 13.5px;
        color: #FAFAF7;
        font-weight: 600;
        line-height: 1.2;
    }
    .admin-sidebar .side-card-text {
        font-size: 10.5px;
        color: rgba(250, 250, 247, 0.55);
        line-height: 1.55;
        margin-top: 5px;
    }
</style>

