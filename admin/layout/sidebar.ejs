                    <path d="M9 12l2 2 4-4"/><path d="M21 12c0 1.66-4 7-9 7s-9-5.34-9-7 4-7 9-7 9 5.34 9 7z"/>
                </svg>
                Approval Center
            </a>
        </li>
        <% } %>

    </ul>

    <div class="side-card">
        <div class="side-card-img"></div>
        <div class="side-card-body">
            <div class="side-card-title">Premium Real Estate Portal</div>
            <div class="side-card-text">One Portal. Complete Control. Smarter Deals. Stronger Relationships.</div>
        </div>
    </div>

</aside>

<!-- ============ MOBILE SHELL (Phase 2) — ADMIN / SUPER-ADMIN ============
     Mirrors the employee shell in views/layout/sidebar.ejs. This markup is INERT
     on desktop: design-system.css keeps every .ds-* at display:none, and
     responsive.css reveals them only at <=768px under body.mshell. Every href
     targets an EXISTING admin route — no route, query or data-shape change.

     DIFFERENCE FROM THE EMPLOYEE SHELL: the admin nav is ~27 permission-gated
     items. Duplicating them into a sheet would mean every future nav change lands
     twice, so the DRAWER above stays as the long tail (reopened by "All Sections")
     and the sheet carries only what you'd actually open one-handed on site.
     body.mshell-admin re-shows the drawer + overlay (see responsive.css).

     Reuses canSee() / _isSuper / _isAdminTier already defined at the top of this
     file — no new permission logic, so the tab bar can never link to a 403. -->
<script>document.body.classList.add('mshell','mshell-admin');</script>

<%
  // Grant-aware tab targets: a fine-role holder (e.g. hr_manager on /admin/projects)
  // is NOT admin tier, so send them somewhere they can actually open.
  const _mHome  = _isAdminTier                ? '/admin/dashboard' : '/hr/dashboard';
  const _mLeads = canSee('leads.view_all')    ? '/admin/leads'     : '/leads';
  const _mProj  = canSee('properties.manage') ? '/admin/projects'  : '/projects';
%>

<header class="ds-mtop" id="dsMtop">
    <div class="ds-mtop-brand">
        <svg class="ds-mtop-logo" viewBox="0 0 258 299" fill="currentColor" aria-label="Dhyaan Enterprises" role="img"><g transform="translate(0,299) scale(0.1,-0.1)"><path d="M10 2978 c-1 -7 -1 -1635 0 -1645 1 -33 48 9 358 319 l332 332 0 308 0 308 28 1 c351 10 559 -34 768 -164 58 -36 164 -135 200 -187 14 -19 41 -57 60 -85 42 -59 108 -195 119 -245 4 -19 11 -39 15 -45 4 -5 18 -53 30 -105 34 -137 34 -444 1 -600 -28 -131 -105 -341 -131 -360 -4 -3 -17 -24 -29 -48 -12 -23 -28 -42 -37 -42 -8 0 -13 -4 -9 -10 19 -31 -250 -259 -288 -244 -8 3 -17 -1 -20 -9 -7 -18 -128 -60 -159 -55 l-23 3 -3 963 c-1 586 -6 962 -11 960 -20 -7 -97 -76 -183 -163 l-88 -90 0 -1027 c0 -810 3 -1029 13 -1035 19 -13 343 -4 437 11 148 25 340 80 340 98 0 5 11 8 24 8 14 0 27 4 30 9 4 5 41 28 83 51 42 22 89 51 104 63 15 12 44 33 64 47 78 53 242 232 293 319 14 25 29 48 33 51 18 13 111 229 139 323 69 232 88 515 51 755 -11 73 -23 137 -26 142 -4 6 -15 43 -26 83 -27 99 -159 359 -228 447 -109 141 -276 291 -391 352 -36 19 -81 44 -100 55 -103 57 -286 114 -450 138 -82 12 -1319 24 -1320 13z"/><path d="M541 1591 l-113 -116 0 -729 c1 -400 4 -731 7 -734 7 -7 243 -4 256 3 5 4 9 338 9 851 l0 844 -22 -2 c-15 -1 -64 -43 -137 -117z"/><path d="M121 1168 l-114 -112 -1 -519 c-1 -335 3 -522 9 -527 12 -10 218 -5 235 5 8 5 11 165 9 613 -1 583 -3 652 -18 652 -3 0 -57 -50 -120 -112z"/></g></svg>
        <span class="ds-mtop-wordmark">DHYAAN ENTERPRISES</span>
    </div>
    <div class="ds-mtop-row">
        <a class="ds-mtop-back" href="<%= _mHome %>" onclick="if(history.length>1){history.back();return false;}" aria-label="Back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <div class="ds-mtop-title"><%= pageTitle || 'Dhyaan Admin' %></div>
        <button class="ds-mtop-more" type="button" onclick="dsSheet('dsMoreSheet')" aria-label="More">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
        </button>
    </div>
</header>

<nav class="ds-tabbar" aria-label="Primary">
    <a class="ds-tab <%= isActive('dashboard') ? 'active' : '' %>" href="<%= _mHome %>">
        <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
    </a>
    <a class="ds-tab <%= isActive('leads') ? 'active' : '' %>" href="<%= _mLeads %>">
        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Leads
    </a>
    <button class="ds-fab" type="button" onclick="dsSheet('dsAddSheet')" aria-label="Quick add">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <a class="ds-tab <%= (isActive('projects') && !isActive('propert')) ? 'active' : '' %>" href="<%= _mProj %>">
        <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>
        Projects
    </a>
    <button class="ds-tab" type="button" onclick="dsSheet('dsMoreSheet')" aria-label="More">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        More
    </button>
</nav>

<div class="ds-sheet-backdrop" id="dsBackdrop" onclick="dsSheetClose()"></div>

<div class="ds-sheet" id="dsAddSheet" role="dialog" aria-label="Quick add">
    <div class="ds-sheet-grip"></div>
    <a class="ds-sheet-item" href="/leads/new">
        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
        New Lead
    </a>
    <% if (canSee('leads.reassign')) { %>
    <a class="ds-sheet-item" href="/admin/assign">
        <svg viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Lead Assignment
    </a>
    <% } %>
</div>

<div class="ds-sheet" id="dsMoreSheet" role="dialog" aria-label="More" style="max-height:82vh;overflow-y:auto;">
    <div class="ds-sheet-grip"></div>
    <a class="ds-sheet-item" href="/admin/follow-ups">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Follow-Ups
    </a>
    <a class="ds-sheet-item" href="/admin/notifications">
        <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        Notifications
    </a>
    <% if (canSee('properties.manage')) { %>
    <a class="ds-sheet-item" href="/admin/properties">
        <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"/></svg>
        Properties
    </a>
    <% } %>
    <% if (canSee('site_visits.manage')) { %>
    <a class="ds-sheet-item" href="/admin/site-visits">
        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Site Visits
    </a>
    <% } %>
    <% if (_isSuper) { %>
    <a class="ds-sheet-item" href="/admin/approvals">
        <svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 1.66-4 7-9 7s-9-5.34-9-7 4-7 9-7 9 5.34 9 7z"/></svg>
        Approval Center
    </a>
    <% } %>
    <button class="ds-sheet-item" type="button" onclick="dsOpenNav()"
            style="width:100%;background:none;border:none;font:inherit;text-align:left;cursor:pointer;">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        All Sections
    </button>
    <a class="ds-sheet-item danger" href="/logout">
        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
    </a>
</div>

<script>
  (function(){
    // Top-level tabs hide the back chevron (title stays centred), same as employee.
    var top = ['/admin/dashboard','/admin/leads','/admin/projects','/hr/dashboard','/leads','/projects'];
    var p = (location.pathname || '/').replace(/\/+$/,'') || '/';
    if (top.indexOf(p) !== -1) { var m = document.getElementById('dsMtop'); if (m) m.classList.add('is-top'); }
  })();
  function dsSheet(id){
    var s = document.getElementById(id), b = document.getElementById('dsBackdrop');
    if (!s) return;
    document.querySelectorAll('.ds-sheet.open').forEach(function(x){ x.classList.remove('open'); });
    s.classList.add('open'); if (b) b.classList.add('open');
  }
  function dsSheetClose(){
    document.querySelectorAll('.ds-sheet.open').forEach(function(x){ x.classList.remove('open'); });
    var b = document.getElementById('dsBackdrop'); if (b) b.classList.remove('open');
  }
  // "All Sections" — close the sheet, slide in the existing drawer (the long tail).
  function dsOpenNav(){ dsSheetClose(); document.body.classList.add('nav-open'); }
</script>
