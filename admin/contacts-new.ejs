<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --gold:#D4AF37; --gold-dark:#B8941F; --navy:#0A1628; --navy-2:#142238; --offwhite:#FAFAF7; --beige:#F4EFE6; --text:#1a1a1a; --muted:#6b6b6b; --border:rgba(10,22,40,0.08); --shadow:0 4px 24px rgba(10,22,40,0.06); --red:#dc2626; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--offwhite); color:var(--text); min-height:100vh; display:flex; }
    h1,h2,h3 { font-family:'Playfair Display',serif; font-weight:600; color:var(--navy); }
    .main-content { flex:1; margin-left:260px; min-height:100vh; display:flex; flex-direction:column; }
    .page-body { padding:28px 40px; flex:1; max-width:820px; }
    .page-hero { background:linear-gradient(135deg,var(--navy) 0%,var(--navy-2) 100%); color:var(--offwhite); padding:24px 30px; border-radius:16px; margin-bottom:22px; box-shadow:var(--shadow); }
    .page-hero h1 { color:var(--offwhite); font-size:26px; margin-bottom:4px; }
    .page-hero p { color:rgba(250,250,247,0.7); font-size:14px; }
    .err { background:rgba(220,38,38,0.1); border:1px solid rgba(220,38,38,0.3); color:var(--red); padding:12px 18px; border-radius:10px; margin-bottom:18px; font-size:13px; font-weight:500; }
    .form-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:var(--shadow); padding:26px 30px; }
    .grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    .field { display:flex; flex-direction:column; gap:6px; margin-bottom:6px; }
    .field.full { grid-column:1 / -1; }
    .field label { font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:var(--muted); font-weight:700; }
    .field label .req { color:var(--red); }
    .field input { font-family:'Inter',sans-serif; font-size:14px; padding:10px 12px; border:1px solid var(--border); border-radius:9px; background:var(--offwhite); }
    .actions { display:flex; gap:10px; margin-top:20px; }
    .btn { font-family:'Inter',sans-serif; font-size:14px; font-weight:600; padding:11px 22px; border-radius:9px; border:none; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; }
    .btn-gold { background:var(--gold); color:var(--navy); }
    .btn-gold:hover { background:var(--gold-dark); color:#fff; }
    .btn-ghost { background:rgba(10,22,40,0.06); color:var(--muted); }
  </style>
</head>
<body>
  <%- include('./layout/sidebar') %>
  <div class="main-content">
    <%- include('./layout/topbar') %>
    <div class="page-body">
      <div class="page-hero">
        <h1>Add Contact</h1>
        <p>New entry in your private builder &amp; broker directory.</p>
      </div>

      <% if (err) { %><div class="err"><%= err %></div><% } %>

      <div class="form-card">
        <form action="/admin/contacts/new" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="grid">
            <div class="field full">
              <label>Builder Name <span class="req">*</span></label>
              <input type="text" name="builder_name" required maxlength="200" placeholder="e.g. Lodha Group" />
            </div>
            <div class="field">
              <label>Contact Person Name</label>
              <input type="text" name="contact_person_name" maxlength="200" placeholder="e.g. Rina Shah" />
            </div>
            <div class="field">
              <label>Designation</label>
              <input type="text" name="designation" maxlength="200" placeholder="e.g. Sales Head" />
            </div>
            <div class="field">
              <label>Project Name</label>
              <input type="text" name="project_name" maxlength="200" placeholder="e.g. Palava City" />
            </div>
            <div class="field">
              <label>Area</label>
              <input type="text" name="area" maxlength="200" placeholder="e.g. Dombivli" />
            </div>
            <div class="field">
              <label>Contact Number</label>
              <input type="tel" name="contact_number" maxlength="40" placeholder="e.g. +91 98XXXXXX21" />
            </div>
            <div class="field">
              <label>Email ID</label>
              <input type="email" name="email" maxlength="200" placeholder="e.g. sales@builder.com" />
            </div>
            <div class="field">
              <label>Alternative Phone</label>
              <input type="tel" name="alt_phone" maxlength="40" placeholder="e.g. +91 99XXXXXX10" />
            </div>
            <div class="field">
              <label>Alt. Contact Name</label>
              <input type="text" name="alt_contact_name" maxlength="200" placeholder="e.g. Rohit (assistant)" />
            </div>
            <div class="field">
              <label>Alt. Contact Phone</label>
              <input type="tel" name="alt_contact_phone" maxlength="40" placeholder="e.g. +91 98XXXXXX22" />
            </div>
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-gold">Save Contact</button>
            <a href="/admin/contacts" class="btn btn-ghost">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
