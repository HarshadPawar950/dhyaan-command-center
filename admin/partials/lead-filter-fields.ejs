<%
   /* Shared lead-filter controls — the 5 .filter-group blocks.
      Included by BOTH the desktop .filter-bar form AND the mobile
      .ds-sheet filter form in leads-list.ejs, so a change (e.g. the
      queued Lead Source additions) lands in ONE place and desktop +
      mobile can never filter differently on the same page.
      Requires locals: filters, locations, sources, employeesList. */
%>
<div class="filter-group">
    <label>Search</label>
    <input type="text" name="q" placeholder="Name, phone, email, code..." value="<%= filters.q %>" />
</div>
<div class="filter-group">
    <label>Status</label>
    <select name="status">
        <option value="">All</option>
        <option value="hot"    <%= filters.status === 'hot'    ? 'selected' : '' %>>Hot</option>
        <option value="warm"   <%= filters.status === 'warm'   ? 'selected' : '' %>>Warm</option>
        <option value="cold"   <%= filters.status === 'cold'   ? 'selected' : '' %>>Cold</option>
        <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
    </select>
</div>
<div class="filter-group">
    <label>Location</label>
    <select name="location">
        <option value="">All</option>
        <% locations.forEach(function(loc) { %>
            <option value="<%= loc %>" <%= filters.location === loc ? 'selected' : '' %>><%= loc %></option>
        <% }); %>
    </select>
</div>
<div class="filter-group">
    <label>Source</label>
    <select name="source">
        <option value="">All</option>
        <% sources.forEach(function(s) { %>
            <option value="<%= s %>" <%= filters.source.toLowerCase() === s.toLowerCase() ? 'selected' : '' %>><%= s %></option>
        <% }); %>
    </select>
</div>
<div class="filter-group">
    <label>Assigned To</label>
    <select name="employee">
        <option value="">All</option>
        <% employeesList.forEach(function(e) { %>
            <option value="<%= e.external_id %>" <%= filters.employee === e.external_id ? 'selected' : '' %>><%= e.name %> (<%= e.external_id %>)</option>
        <% }); %>
    </select>
</div>
