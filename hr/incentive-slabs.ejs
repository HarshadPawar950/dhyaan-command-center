<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Incentive Slabs | Dhyaan</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .hr-wrap { padding: 1.5rem 2rem; max-width: 1000px; margin: 0 auto; }
    .hr-head { display:flex; justify-content:space-between; align-items:flex-end; border-bottom:2px solid #D4AF37; padding-bottom:1rem; margin-bottom:1.5rem; }
    .hr-head h1 { font-family:'Playfair Display',serif; font-size:1.8rem; color:#0A1628; font-weight:600; }
    .hr-head .sub { color:#6B7280; font-size:.85rem; margin-top:.25rem; }
    .flash { padding:.7rem 1rem; border-radius:8px; margin-bottom:1rem; font-size:.9rem; }
    .flash.ok { background:#DCFCE7; color:#166534; } .flash.err { background:#FEE2E2; color:#991B1B; }
    .grid2 { display:grid; grid-template-columns:1.4fr 1fr; gap:1.5rem; align-items:start; }
    .panel { background:#fff; border-radius:10px; padding:1.25rem; box-shadow:0 2px 8px rgba(10,22,40,.05); }
    .panel h2 { font-family:'Playfair Display',serif; font-size:1.1rem; color:#0A1628; border-bottom:1.5px solid #D4AF37; padding-bottom:.5rem; margin-bottom:.8rem; }
    table { width:100%; border-collapse:collapse; font-size:.85rem; }
    th { text-align:left; font-size:.66rem; text-transform:uppercase; letter-spacing:.05em; color:#6B7280; padding:.45rem .5rem; border-bottom:1px solid #E5E7EB; }
    th.num, td.num { text-align:right; }
    td { padding:.5rem .5rem; border-bottom:1px solid #F3F4F6; color:#1F2937; }
    .st { font-size:.68rem; font-weight:700; padding:.12rem .45rem; border-radius:999px; }
    .st.on { background:#DCFCE7; color:#166534; } .st.off { background:#F3F4F6; color:#6B7280; }
    .field { margin-bottom:.9rem; }
    .field label { display:block; font-size:.8rem; font-weight:600; color:#374151; margin-bottom:.3rem; }
    .field input { width:100%; padding:.5rem .6rem; border:1px solid #e5e7eb; border-radius:7px; font-size:.9rem; }
    .btn-a { border:none; border-radius:6px; padding:.35rem .7rem; font-size:.75rem; font-weight:700; cursor:pointer; }
    .btn-a.add { background:#0A1628; color:#D4AF37; width:100%; padding:.6rem; }
    .btn-a.tog { background:#6B7280; color:#fff; }
    .hint { font-size:.75rem; color:#9ca3af; margin-top:.4rem; }
    .empty { color:#9CA3AF; font-style:italic; padding:1rem; text-align:center; }
    @media(max-width:800px){ .grid2{grid-template-columns:1fr;} }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <%- topbarHtml %>
  <main class="main-content">
    <div class="hr-wrap">
      <div class="hr-head">
        <div><h1>Incentive Slabs</h1><div class="sub">Bands on the exec's commission share (employee_share). Changes are logged.</div></div>
        <div><a href="/hr/incentives" style="font-size:.85rem;color:#0A1628;font-weight:600;">← Dashboard</a></div>
      </div>

      <% if (messages && messages.success && messages.success.length) { %><div class="flash ok"><%= messages.success.join(' ') %></div><% } %>
      <% if (messages && messages.error && messages.error.length) { %><div class="flash err"><%= messages.error.join(' ') %></div><% } %>

      <div class="grid2">
        <div class="panel">
          <h2>Slabs</h2>
          <table>
            <thead><tr><th class="num">Min</th><th class="num">Max</th><th class="num">Rate</th><th>State</th><th></th></tr></thead>
            <tbody>
              <% if (slabs.length) { %>
                <% slabs.forEach(function(s) { %>
                  <tr>
                    <td class="num">&#8377;<%= Number(s.min_amount).toLocaleString('en-IN',{maximumFractionDigits:0}) %></td>
                    <td class="num"><%= s.max_amount === null ? 'open' : '₹' + Number(s.max_amount).toLocaleString('en-IN',{maximumFractionDigits:0}) %></td>
                    <td class="num"><%= s.rate_percent %>%</td>
                    <td><span class="st <%= s.active ? 'on' : 'off' %>"><%= s.active ? 'active' : 'inactive' %></span></td>
                    <td>
                      <form method="POST" action="/hr/incentive-slabs/<%= s.slab_id %>/toggle" style="margin:0;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn-a tog" type="submit"><%= s.active ? 'Deactivate' : 'Activate' %></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %><tr><td colspan="5" class="empty">No slabs.</td></tr><% } %>
            </tbody>
          </table>
        </div>

        <div class="panel">
          <h2>Add Slab</h2>
          <form method="POST" action="/hr/incentive-slabs">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label>Min amount (₹)</label><input type="number" name="min_amount" min="0" step="1000" required></div>
            <div class="field"><label>Max amount (₹) — blank = open top</label><input type="number" name="max_amount" min="0" step="1000"></div>
            <div class="field"><label>Rate (%)</label><input type="number" name="rate_percent" min="0" max="100" step="0.25" required></div>
            <button class="btn-a add" type="submit">Add Slab</button>
            <div class="hint">Rate applies to the exec's share on a deal within this band.</div>
          </form>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
