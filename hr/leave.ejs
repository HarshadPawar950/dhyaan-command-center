<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leave Approvals | Dhyaan</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .hr-wrap { padding: 1.5rem 2rem; max-width: 1400px; margin: 0 auto; }
    .hr-head { display:flex; justify-content:space-between; align-items:flex-end; border-bottom:2px solid #D4AF37; padding-bottom:1rem; margin-bottom:1.5rem; }
    .hr-head h1 { font-family:'Playfair Display',serif; font-size:1.8rem; color:#0A1628; font-weight:600; }
    .hr-head .sub { color:#6B7280; font-size:.85rem; margin-top:.25rem; }
    .flash { padding:.7rem 1rem; border-radius:8px; margin-bottom:1rem; font-size:.9rem; }
    .flash.ok { background:#DCFCE7; color:#166534; } .flash.err { background:#FEE2E2; color:#991B1B; }
    .chips { display:flex; gap:.6rem; margin-bottom:1rem; }
    .chip { background:#fff; border-radius:8px; padding:.5rem .9rem; box-shadow:0 2px 8px rgba(10,22,40,.05); font-size:.8rem; color:#6B7280; }
    .chip b { color:#0A1628; font-size:1rem; }
    .panel { background:#fff; border-radius:10px; padding:1.25rem; box-shadow:0 2px 8px rgba(10,22,40,.05); }
    table { width:100%; border-collapse:collapse; font-size:.88rem; }
    th { text-align:left; font-size:.68rem; text-transform:uppercase; letter-spacing:.05em; color:#6B7280; padding:.5rem .6rem; border-bottom:1px solid #E5E7EB; }
    td { padding:.55rem .6rem; border-bottom:1px solid #F3F4F6; color:#1F2937; vertical-align:middle; }
    .st { font-size:.7rem; font-weight:700; padding:.15rem .5rem; border-radius:999px; }
    .st.pending { background:#FEF3C7; color:#92400E; } .st.approved { background:#DCFCE7; color:#166534; } .st.rejected { background:#FEE2E2; color:#991B1B; }
    .act { display:flex; gap:.4rem; align-items:center; }
    .act input[type=text] { padding:.35rem .5rem; border:1px solid #e5e7eb; border-radius:6px; font-size:.8rem; width:130px; }
    .btn-a { border:none; border-radius:6px; padding:.4rem .7rem; font-size:.78rem; font-weight:700; cursor:pointer; }
    .btn-a.ok { background:#16A34A; color:#fff; } .btn-a.no { background:#DC2626; color:#fff; }
    .empty { color:#9CA3AF; font-style:italic; padding:1rem; text-align:center; }
  </style>
</head>
<body>
  <%- sidebarHtml %>
  <%- topbarHtml %>
  <main class="main-content">
    <div class="hr-wrap">
      <div class="hr-head">
        <div><h1>Leave Approvals</h1><div class="sub">Approve or reject staff leave requests — decisions are logged.</div></div>
      </div>

      <% if (messages && messages.success && messages.success.length) { %><div class="flash ok"><%= messages.success.join(' ') %></div><% } %>
      <% if (messages && messages.error && messages.error.length) { %><div class="flash err"><%= messages.error.join(' ') %></div><% } %>

      <div class="chips">
        <div class="chip">Pending <b><%= counts.pending || 0 %></b></div>
        <div class="chip">Approved <b><%= counts.approved || 0 %></b></div>
        <div class="chip">Rejected <b><%= counts.rejected || 0 %></b></div>
      </div>

      <div class="panel">
        <table>
          <thead><tr><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% if (requests.length) { %>
              <% requests.forEach(function(r) { %>
                <tr>
                  <td><%= r.emp_name %> <span style="color:#9ca3af;">(<%= r.emp_code %>)</span></td>
                  <td><%= r.type_name %></td>
                  <td><%= new Date(r.from_date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></td>
                  <td><%= new Date(r.to_date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></td>
                  <td><%= r.days %></td>
                  <td style="max-width:180px;"><%= r.reason || '—' %></td>
                  <td><span class="st <%= r.status %>"><%= r.status %></span><% if (r.status !== 'pending' && r.decided_by_name) { %><div style="font-size:.7rem;color:#9ca3af;">by <%= r.decided_by_name %></div><% } %></td>
                  <td>
                    <div class="act">
                      <% if (r.status === 'pending') { %>
                        <form method="POST" action="/hr/leave/<%= r.request_id %>/decision" class="act">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="text" name="reason" placeholder="reason (opt)">
                          <button class="btn-a ok" name="action" value="approve">Approve</button>
                          <button class="btn-a no" name="action" value="reject">Reject</button>
                        </form>
                      <% } %>
                      <form method="POST" action="/hr/leave/<%= r.request_id %>/delete" style="display:inline;" onsubmit="return confirm('Remove this leave request? (soft-delete, recoverable)');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn-a" style="background:#6B7280;color:#fff;">Remove</button>
                      </form>
                    </div>
                    <% if (r.status === 'pending') { %>
                      <details style="margin-top:.4rem;">
                        <summary style="cursor:pointer;font-size:.74rem;color:#2563eb;">Edit dates / reason</summary>
                        <form method="POST" action="/hr/leave/<%= r.request_id %>/edit" style="margin-top:.4rem;display:flex;gap:.3rem;flex-wrap:wrap;align-items:center;">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="date" name="from_date" value="<%= r.from_ymd %>" required>
                          <input type="date" name="to_date" value="<%= r.to_ymd %>" required>
                          <input type="text" name="reason" placeholder="reason" value="<%= r.reason || '' %>" style="width:120px;">
                          <button class="btn-a" style="background:#2563eb;color:#fff;">Save</button>
                        </form>
                      </details>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="8" class="empty">No leave requests yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
