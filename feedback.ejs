<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Dhyaan Realty</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <%- include('layout/sidebar') %>
    <main class="main-content">
      <%- include('layout/topbar') %>
      <%- include('layout/messages') %>
      <div class="page-hero">
        <h1>Add Feedback</h1>
        <p>Record details from your client interactions.</p>
      </div>
      <div class="card" style="max-width: 600px; margin: 24px auto 0;">
        <h2 style="margin-bottom: 2rem; text-align: center;">Record Client Feedback</h2>
        <form action="/feedback" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="lead_id">Select Lead</label>
            <select name="lead_id" id="lead_id" class="form-control" required>
              <option value="" disabled selected>-- Choose a lead --</option>
              <% leads.forEach(lead => { %>
                <option value="<%= lead.lead_id %>"><%= lead.name %> (<%= lead.phone %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="rating">Interaction Rating (1-5)</label>
            <input type="number" id="rating" name="rating" min="1" max="5" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="comments">Feedback Details</label>
            <textarea id="comments" name="comments" class="form-control" rows="5" required placeholder="Enter details of your interaction..."></textarea>
          </div>
          <button type="submit" class="btn btn-accent" style="width: 100%; margin-top: 1rem;">Submit Feedback</button>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
