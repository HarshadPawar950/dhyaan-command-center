<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> — Dhyaan Portal</title>
    <!-- RENDER-SOURCE: views/property-detail.ejs (employee PROJECT detail) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
            --navy: #0A1628; --navy-2: #142238;
            --offwhite: #FAFAF7; --beige: #F4EFE6;
            --text: #1a1a1a; --muted: #6b6b6b;
            --border: rgba(10, 22, 40, 0.08);
            --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
            --green: #16a34a; --blue: #2563eb;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }

        .topbar {
            background: #fff; border-bottom: 1px solid var(--border);
            padding: 14px 28px; display: flex; justify-content: space-between; align-items: center;
        }
        .back-link { color: var(--gold-dark); font-size: 13px; font-weight: 600; text-decoration: none; }
        .user-pill {
            display: flex; align-items: center; gap: 10px;
            background: var(--beige); padding: 6px 12px; border-radius: 999px;
        }
        .avatar-mini {
            width: 28px; height: 28px; border-radius: 50%;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%);
            color: var(--navy); display: flex; align-items: center; justify-content: center;
            font-family: 'Playfair Display', serif; font-weight: 700; font-size: 12px;
        }
        .user-name { font-size: 13px; font-weight: 600; color: var(--navy); }
        .logout-btn { padding: 8px 14px; font-size: 12px; font-weight: 600; background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; }
        .topbar-right { display: flex; align-items: center; gap: 14px; }

        .page-body { max-width: 1200px; margin: 24px auto; padding: 0 24px; }

        .property-header {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
            color: var(--offwhite); padding: 32px 36px;
            border-radius: 16px; margin-bottom: 22px;
            position: relative; overflow: hidden; box-shadow: var(--shadow);
        }
        .property-header::before {
            content: ""; position: absolute; top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%);
        }
        .ext-code {
            color: var(--gold); font-size: 11px;
            text-transform: uppercase; letter-spacing: 2px;
            font-weight: 600; margin-bottom: 8px;
        }
        .property-header h1 {
            color: var(--offwhite); font-size: 32px;
            margin-bottom: 6px; letter-spacing: -0.5px;
        }
        .by-builder { color: rgba(250,250,247,0.75); font-size: 15px; margin-bottom: 14px; }
        .header-badges { display: flex; gap: 8px; flex-wrap: wrap; }
        .badge {
            display: inline-block; font-size: 10px;
            text-transform: uppercase; letter-spacing: 1px;
            font-weight: 700; padding: 5px 10px; border-radius: 5px;
        }
        .badge-tier {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%);
            color: var(--navy);
        }
        .badge-status { background: rgba(37,99,235,0.22); color: #6ba1f5; }
        .badge-area { background: rgba(255,255,255,0.16); color: var(--offwhite); }
        .badge-type { background: rgba(255,255,255,0.12); color: var(--offwhite); }

        .info-grid {
            display: grid; grid-template-columns: 2fr 1fr;
            gap: 20px; margin-bottom: 22px;
        }
        @media (max-width: 1000px) { .info-grid { grid-template-columns: 1fr; } }

        .panel {
            background: #fff; border-radius: 14px; border: 1px solid var(--border);
            box-shadow: var(--shadow); overflow: hidden;
        }
        .panel-head {
            padding: 16px 22px; border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
        }
        .panel-head h2 { font-size: 17px; }
        .panel-body { padding: 20px 22px; }

        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; }
        @media (max-width: 600px) { .detail-grid { grid-template-columns: 1fr; } }
        .detail-label {
            font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px;
            color: var(--muted); font-weight: 600; margin-bottom: 3px;
        }
        .detail-value { font-size: 14px; color: var(--navy); font-weight: 500; }
        .detail-row-wide { grid-column: 1 / -1; }
        .detail-note {
            font-size: 13px; color: var(--text); line-height: 1.6;
            padding: 10px 12px; background: var(--beige); border-radius: 8px;
        }

        .price-hero {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%);
            color: var(--navy); padding: 22px 24px;
            border-radius: 14px; box-shadow: var(--shadow);
        }
        .ph-label {
            font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;
            font-weight: 700; opacity: 0.85; margin-bottom: 6px;
        }
        .ph-value {
            font-family: 'Playfair Display', serif;
            font-size: 26px; font-weight: 700;
        }

        .units-table { width: 100%; border-collapse: collapse; }
        .units-table thead th {
            font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px;
            color: var(--muted); font-weight: 600;
            text-align: left; padding: 13px 22px;
            background: var(--beige); border-bottom: 1px solid var(--border);
        }
        .units-table tbody td {
            padding: 14px 22px; border-bottom: 1px solid var(--border);
            font-size: 13px;
        }
        .units-table tbody tr:hover { background: rgba(212,175,55,0.05); }
        @media (max-width: 768px) { .units-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; white-space: nowrap; } }

        .config-pill {
            display: inline-block;
            padding: 4px 10px; border-radius: 999px;
            background: rgba(37,99,235,0.10); color: var(--blue);
            font-size: 11px; font-weight: 700; text-transform: uppercase;
        }
        .price-strong {
            font-family: 'Playfair Display', serif;
            font-weight: 700; color: var(--navy); font-size: 14px;
        }
        .lakhs-num {
            font-family: 'Playfair Display', serif;
            color: var(--gold-dark); font-weight: 700;
        }
        .muted-cell { color: var(--muted); }
    </style>
</head>
<body>

    <%- include('layout/sidebar') %>
    <div class="main-content">

    <div class="topbar">
        <div>
            <a href="<%= typeof propsBase !== 'undefined' && propsBase ? propsBase : '/projects' %>" class="back-link">← All Properties</a>
        </div>
        <div class="topbar-right">
            <div class="user-pill">
                <div class="avatar-mini"><%= (user.name || '?').charAt(0).toUpperCase() %></div>
                <div class="user-name"><%= user.name %></div>
            </div>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>
    </div>

    <div class="page-body">

        <div class="property-header">
            <% if (property.external_id) { %><div class="ext-code"><%= property.external_id %></div><% } %>
            <h1><%= property.title %></h1>
            <% if (property.builder || property.location) { %>
                <div class="by-builder">
                    <% if (property.builder) { %>by <strong style="color: var(--gold);"><%= property.builder %></strong><% } %>
                    <% if (property.builder && property.location) { %> · <% } %>
                    <%= property.location %>
                </div>
            <% } %>
            <div class="header-badges">
                <% if (property.has_residential) { %><span class="badge" style="background:#0A1628;color:#D4AF37;font-weight:700;letter-spacing:.5px;">🏠 RESIDENTIAL</span><% } %>
                <% if (property.has_commercial) { %><span class="badge" style="background:#0A1628;color:#D4AF37;font-weight:700;letter-spacing:.5px;">🏢 COMMERCIAL</span><% } %>
                <% if (property.tier) { %><span class="badge badge-tier"><%= property.tier %></span><% } %>
                <% (Array.isArray(property.status_of_property) ? property.status_of_property : []).forEach(function(sk){ %><span class="badge badge-status"><%= (typeof sheet !== 'undefined' && sheet && sheet.statusLabel) ? sheet.statusLabel(sk) : sk.replace(/_/g, ' ') %></span><% }); %>
                <% if (property.area_zone) { %><span class="badge badge-area"><%= property.area_zone %></span><% } %>
                <% if (property.type) { %><span class="badge badge-type"><%= property.type %></span><% } %>
            </div>
            <% if (typeof configSummary !== 'undefined' && configSummary) { %>
                <div class="config-summary" style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(212,175,55,0.25);color:var(--gold-soft);font-size:15px;font-weight:600;letter-spacing:0.2px;"><%= configSummary %></div>
            <% } %>
        </div>

        <!-- MEDIA — Photos | Videos | Brochures (Δ3 tabs, Δ10 downloads) -->
        <%
            var _imgs = (typeof images    !== 'undefined' && images)    ? images    : [];
            var _vids = (typeof videos    !== 'undefined' && videos)    ? videos    : [];
            var _brcs = (typeof brochures !== 'undefined' && brochures) ? brochures : [];
            var _fps  = (typeof floorPlans!== 'undefined' && floorPlans)? floorPlans: [];
        %>
        <style>
            .media-tabs input[type=radio]{position:absolute;opacity:0;pointer-events:none;}
            .mt-bar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
            .mt-bar label{padding:9px 16px;border:1px solid rgba(10,22,40,0.12);border-radius:999px;font-size:13px;font-weight:600;color:#6b6b6b;background:#fff;cursor:pointer;user-select:none;}
            .mt-bar label:hover{border-color:#D4AF37;}
            .media-tabs #mt-photos:checked ~ .mt-bar label[for=mt-photos],
            .media-tabs #mt-videos:checked ~ .mt-bar label[for=mt-videos],
            .media-tabs #mt-floorplans:checked ~ .mt-bar label[for=mt-floorplans],
            .media-tabs #mt-brochures:checked ~ .mt-bar label[for=mt-brochures]{background:#0A1628;color:#D4AF37;border-color:#0A1628;}
            .mt-panel{display:none;}
            .media-tabs #mt-photos:checked ~ .mt-photos,
            .media-tabs #mt-videos:checked ~ .mt-videos,
            .media-tabs #mt-floorplans:checked ~ .mt-floorplans,
            .media-tabs #mt-brochures:checked ~ .mt-brochures{display:block;}
            .fp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;}
            .fp-card{border:1px solid rgba(10,22,40,0.1);border-radius:10px;overflow:hidden;background:#fff;position:relative;}
            .fp-card img{width:100%;display:block;background:#f4efe6;}
            .fp-cap{font-size:12px;color:#6b6b6b;padding:8px 10px;}
            .media-dl{position:absolute;bottom:8px;right:8px;background:rgba(10,22,40,0.82);color:#D4AF37;width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;text-decoration:none;z-index:3;}
            .media-dl:hover{background:#0A1628;}
            .vid-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;}
            .vid-card video{width:100%;border-radius:10px;background:#000;display:block;}
            .vid-meta{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px;}
            .vid-meta .nm{font-size:12px;color:#6b6b6b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
            .brc-list{display:flex;flex-direction:column;gap:10px;}
            .brc-row{display:flex;align-items:center;gap:14px;padding:12px 14px;border:1px solid rgba(10,22,40,0.1);border-radius:10px;background:#fff;}
            .brc-ico{font-size:26px;color:#D4AF37;}
            .brc-nm{flex:1;font-size:14px;font-weight:600;color:#0A1628;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
            .brc-btn{font-size:12px;font-weight:600;color:#0A1628;border:1px solid rgba(10,22,40,0.14);border-radius:8px;padding:8px 12px;text-decoration:none;}
            .media-empty{color:#6b6b6b;font-size:14px;padding:8px 0;}
        </style>
        <div class="media-tabs">
            <input type="radio" name="mediatab" id="mt-photos" checked>
            <input type="radio" name="mediatab" id="mt-videos">
            <input type="radio" name="mediatab" id="mt-floorplans">
            <input type="radio" name="mediatab" id="mt-brochures">
            <div class="mt-bar">
                <label for="mt-photos">📷 Photos (<%= _imgs.length %>)</label>
                <label for="mt-videos">🎬 Videos (<%= _vids.length %>)</label>
                <label for="mt-floorplans">📐 Floor Plans (<%= _fps.length %>)</label>
                <label for="mt-brochures">📄 Brochures (<%= _brcs.length %>)</label>
            </div>

            <div class="mt-panel mt-photos">
                <div class="pg-gallery" data-count="<%= _imgs.length %>">
                    <% if (_imgs.length) { %>
                        <div class="pg-viewport">
                            <div class="pg-track">
                                <% _imgs.forEach(function(img){ %>
                                    <div class="pg-slide">
                                        <img class="lb" src="<%= img.file_path %>" alt="<%= img.caption || property.title %>" loading="lazy">
                                        <a class="media-dl" href="<%= img.file_path %>" download="<%= img.original_name || '' %>" title="Download photo">⬇</a>
                                    </div>
                                <% }); %>
                            </div>
                            <% if (_imgs.length > 1) { %>
                                <button class="pg-arrow pg-prev" type="button" aria-label="Previous photo">&#8249;</button>
                                <button class="pg-arrow pg-next" type="button" aria-label="Next photo">&#8250;</button>
                                <div class="pg-dots"></div>
                            <% } %>
                        </div>
                    <% } else { %><div class="pg-empty">No photos yet.</div><% } %>
                </div>
            </div>

            <div class="mt-panel mt-videos">
                <% if (_vids.length) { %>
                    <div class="vid-grid">
                        <% _vids.forEach(function(v){ %>
                            <div class="vid-card">
                                <video src="<%= v.file_path %>" controls preload="metadata"></video>
                                <div class="vid-meta">
                                    <span class="nm" title="<%= v.original_name || '' %>"><%= v.original_name || 'video' %></span>
                                    <a class="brc-btn" href="<%= v.file_path %>" download="<%= v.original_name || '' %>">⬇ Download</a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><div class="media-empty">No videos yet.</div><% } %>
            </div>

            <div class="mt-panel mt-floorplans">
                <% if (_fps.length) { %>
                    <div class="fp-grid">
                        <% _fps.forEach(function(fp){ %>
                            <div class="fp-card">
                                <a href="<%= fp.file_path %>" target="_blank" rel="noopener"><img src="<%= fp.file_path %>" alt="<%= fp.caption || 'Floor plan' %>" loading="lazy"></a>
                                <div class="fp-cap"><%= fp.caption || fp.original_name || 'Floor plan' %></div>
                                <a class="media-dl" href="<%= fp.file_path %>" download="<%= fp.original_name || '' %>" title="Download floor plan">⬇</a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><div class="media-empty">No floor plans yet.</div><% } %>
            </div>

            <div class="mt-panel mt-brochures">
                <% if (_brcs.length) { %>
                    <div class="brc-list">
                        <% _brcs.forEach(function(b){ %>
                            <div class="brc-row">
                                <span class="brc-ico">📄</span>
                                <span class="brc-nm" title="<%= b.original_name || '' %>"><%= b.original_name || 'brochure.pdf' %></span>
                                <a class="brc-btn" href="<%= b.file_path %>" target="_blank" rel="noopener">Open</a>
                                <a class="brc-btn" href="<%= b.file_path %>" download="<%= b.original_name || '' %>">⬇ Download</a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><div class="media-empty">No brochures yet.</div><% } %>
            </div>
        </div>
        <script src="/js/gallery.js"></script>

        <%- include('partials/project-99acres-sections') %>

        <%- include('partials/project-sheet-display') %>

        <div class="info-grid">
            <div class="panel">
                <div class="panel-head"><h2>Project Details</h2></div>
                <div class="panel-body">
                    <%
                        function _fmtDate(d){ if(!d) return null; try{ return new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}); }catch(e){ return null; } }
                        var _statusMap = { pre_launch:'New Launch', under_construction:'Under Construction', near_possession:'Near Possession', ready_to_move:'Ready to Move', completed:'Completed' };
                        var _statusArr = Array.isArray(property.status_of_property) ? property.status_of_property : [];
                        var _projStatus = _statusArr.length ? _statusArr.map(function(sk){ return _statusMap[sk] || sk.replace(/_/g,' '); }).join(' · ') : null;
                        var _possDate = _fmtDate(property.possession_date);
                        var _launch   = _fmtDate(property.launch_date);
                    %>
                    <div class="detail-grid">
                        <div><div class="detail-label">Builder</div><div class="detail-value"><%= property.builder || '—' %></div></div>
                        <div><div class="detail-label">Location</div><div class="detail-value"><%= property.location || '—' %></div></div>
                        <div><div class="detail-label">Status</div><div class="detail-value"><%= _projStatus || '—' %></div></div>
                        <div><div class="detail-label">Possession</div><div class="detail-value"><%= _possDate || property.possession || '—' %></div></div>
                        <div><div class="detail-label">Configurations</div><div class="detail-value"><%= property.configurations || (typeof configSummary!=='undefined'&&configSummary ? configSummary : '—') %></div></div>
                        <div><div class="detail-label">Total Towers</div><div class="detail-value"><%= (property.total_towers!=null)? property.total_towers : '—' %></div></div>
                        <div><div class="detail-label">Total Units</div><div class="detail-value"><%= (property.total_units_count!=null)? property.total_units_count : '—' %></div></div>
                        <div><div class="detail-label">Land Area</div><div class="detail-value"><%= (property.land_area!=null)? (property.land_area + ' ' + (property.land_area_unit||'acres')) : '—' %></div></div>
                        <div><div class="detail-label">Launch Date</div><div class="detail-value"><%= _launch || '—' %></div></div>
                        <div><div class="detail-label">Tier</div><div class="detail-value"><%= property.tier || '—' %></div></div>
                        <% if (property.notes) { %>
                            <div class="detail-row-wide">
                                <div class="detail-label">Notes</div>
                                <div class="detail-note"><%= property.notes %></div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div>
                <% if (property.price_range) { %>
                <div class="price-hero">
                    <div class="ph-label">Price Range</div>
                    <div class="ph-value"><%= property.price_range %></div>
                    <% if (property.price_list_note) { %><div style="font-size:12px;margin-top:8px;opacity:0.85;"><%= property.price_list_note %></div><% } %>
                </div>
                <% } %>

                <!-- Builder card -->
                <% if (property.builder) { %>
                <div class="panel" style="margin-top:16px;">
                    <div class="panel-head"><h2 style="font-size:15px;">Builder</h2></div>
                    <div class="panel-body" style="display:flex;align-items:center;gap:12px;">
                        <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold-soft));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;color:var(--navy);font-size:20px;flex-shrink:0;"><%= property.builder.charAt(0).toUpperCase() %></div>
                        <div>
                            <div style="font-weight:700;color:var(--navy);font-size:15px;"><%= property.builder %></div>
                            <div style="font-size:12px;color:var(--muted);">Developer</div>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- RERA line -->
                <% if (property.rera_number) { %>
                <div class="panel" style="margin-top:16px;">
                    <div class="panel-body" style="display:flex;align-items:center;gap:10px;">
                        <span style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--green);background:rgba(22,163,74,0.1);padding:4px 8px;border-radius:5px;">RERA</span>
                        <span style="font-size:13px;font-weight:600;color:var(--navy);font-family:'Playfair Display',serif;letter-spacing:0.5px;"><%= property.rera_number %></span>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <!-- About / Amenities / Location Advantages render via the shared
             partials/project-99acres-sections include above (single source). -->

        <!-- LOCATION & MAP (Launch Day) -->
        <div class="panel" style="margin-top:20px;">
            <div class="panel-head">
                <h2>Location</h2>
                <% if (typeof map !== 'undefined' && map && map.openUrl) { %>
                    <a href="<%= map.openUrl %>" target="_blank" rel="noopener"
                       style="font-size:12px;font-weight:600;color:#0A1628;border:1px solid rgba(10,22,40,0.14);border-radius:8px;padding:8px 12px;text-decoration:none;">Open in Google Maps →</a>
                <% } %>
            </div>
            <div class="panel-body">
                <% if (typeof map !== 'undefined' && map && map.embedSrc) { %>
                    <div style="width:100%;border-radius:12px;overflow:hidden;border:1px solid rgba(10,22,40,0.08);">
                        <iframe src="<%= map.embedSrc %>" width="100%" height="320" style="border:0;display:block;"
                                loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Property location map"></iframe>
                    </div>
                <% } else { %>
                    <div style="color:#6b6b6b;font-size:14px;padding:8px 0;">Location not set.</div>
                <% } %>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Properties</h2>
                <span style="font-size: 11px; color: var(--gold-dark); font-weight: 600; text-transform: uppercase; letter-spacing: 1px;"><%= units.length %> total</span>
            </div>
            <% if (units && units.length > 0) { %>
            <%
                function _cap(s){ return s ? s.replace(/_/g,' ').replace(/\b\w/g, function(c){return c.toUpperCase();}) : null; }
                function _carpet(u){ if(u.carpet_area!=null&&!isNaN(Number(u.carpet_area)))return Number(u.carpet_area); if(u.carpet_sqft&&!isNaN(Number(u.carpet_sqft)))return Number(u.carpet_sqft); return null; }
                function _priceNum(u){ if(u.expected_price!=null)return Number(u.expected_price); if(u.price_lakhs!=null)return Number(u.price_lakhs)*100000; return null; }
            %>
            <table class="units-table" id="inv-table-e">
                <thead>
                    <tr>
                        <th>Configuration</th>
                        <th>Carpet</th>
                        <th class="sortable" onclick="sortInvE()" style="cursor:pointer;user-select:none;">Price <span id="inv-e-ind">▲</span></th>
                        <th>Floor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="inv-body-e">
                    <% units.forEach(function(u) { %>
                        <tr data-price="<%= _priceNum(u)!=null ? _priceNum(u) : -1 %>" onclick="location.href='/properties/<%= u.property_id %>'" style="cursor:pointer;" title="View property details">
                            <td><% if (u.config) { %><span class="config-pill"><%= u.config %></span><% if (u.title) { %> <span class="muted-cell" style="font-size:12px;"><%= u.title %></span><% } %><% } else { %><span class="muted-cell">—</span><% } %></td>
                            <td><% var _ca = _carpet(u); %><% if (_ca != null) { %><%= _ca %><span class="muted-cell" style="font-size:11px;"> <%= u.area_unit || 'sqft' %></span><% } else { %><span class="muted-cell">—</span><% } %></td>
                            <td class="price-strong">
                                <% if (u.expected_price != null) { %>₹<%= Number(u.expected_price).toLocaleString('en-IN') %><% if (u.price_per_sqft != null) { %><div class="lakhs-num" style="font-size:11px;">₹<%= Number(u.price_per_sqft).toLocaleString('en-IN') %>/sqft</div><% } %>
                                <% } else if (u.price_lakhs != null) { %><span class="lakhs-num">₹<%= Number(u.price_lakhs).toLocaleString('en-IN') %> L</span>
                                <% } else { %><span class="muted-cell">—</span><% } %>
                            </td>
                            <td><% if (u.floor_number != null) { %><%= u.floor_number %><% if (u.total_floors != null) { %><span class="muted-cell" style="font-size:11px;"> / <%= u.total_floors %></span><% } %><% } else { %><span class="muted-cell">—</span><% } %></td>
                            <td><% if(u.possession_status){ %><span style="display:inline-block;padding:3px 9px;border-radius:999px;background:rgba(37,99,235,0.10);color:var(--blue);font-size:11px;font-weight:700;"><%= _cap(u.possession_status) %></span><% }else{ %><span class="muted-cell">—</span><% } %></td>
                            <td class="muted-cell" style="text-align:right;color:var(--gold-dark);font-weight:700;">view →</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            <script>
            var _invEAsc = true;
            function sortInvE(){
                var body = document.getElementById('inv-body-e');
                var rows = Array.prototype.slice.call(body.querySelectorAll('tr'));
                rows.sort(function(a,b){ return _invEAsc ? (+a.dataset.price)-(+b.dataset.price) : (+b.dataset.price)-(+a.dataset.price); });
                _invEAsc = !_invEAsc;
                document.getElementById('inv-e-ind').textContent = _invEAsc ? '▲' : '▼';
                rows.forEach(function(r){ body.appendChild(r); });
            }
            </script>
            <% } else { %>
                <div style="padding: 40px; text-align: center; color: var(--muted);">No properties on file for this project yet.</div>
            <% } %>
        </div>

    </div>

    </div><!-- /.main-content -->

    <%# --- zero-dependency image lightbox (inlined; res.render context) ---
        Any <img class="lb"> becomes clickable: opens full-size in a dark overlay
        scaled to fit the viewport. Click anywhere or press Esc to close. Photos
        only. The per-photo download <a> is separate and keeps working. %>
    <style>
      img.lb { cursor: zoom-in; }
      #lb-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: none; align-items: center; justify-content: center;
        background: rgba(0,0,0,0.9); cursor: zoom-out;
      }
      #lb-overlay.open { display: flex; }
      #lb-overlay img {
        max-width: 92vw; max-height: 92vh;
        object-fit: contain; box-shadow: 0 8px 40px rgba(0,0,0,0.6);
        border-radius: 4px;
      }
      #lb-close {
        position: fixed; top: 18px; right: 24px; z-index: 10000;
        color: #fff; font-size: 34px; line-height: 1; cursor: pointer;
        background: none; border: none; opacity: 0.85;
      }
    </style>
    <div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button id="lb-close" type="button" aria-label="Close">&times;</button>
      <img id="lb-img" src="" alt="">
    </div>
    <script>
      (function () {
        var overlay = document.getElementById('lb-overlay');
        var lbImg = document.getElementById('lb-img');
        if (!overlay || !lbImg) return;
        function open(src, alt) { lbImg.src = src; lbImg.alt = alt || ''; overlay.classList.add('open'); }
        function close() { overlay.classList.remove('open'); lbImg.src = ''; }
        document.addEventListener('click', function (e) {
          var img = e.target.closest && e.target.closest('img.lb');
          if (img) { e.preventDefault(); open(img.getAttribute('src'), img.getAttribute('alt')); }
        });
        overlay.addEventListener('click', close); // click anywhere on overlay (incl. image) closes
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });
      })();
    </script>
</body>
</html>
