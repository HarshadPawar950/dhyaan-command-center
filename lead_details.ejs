<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lead Details | Dhyaan Employee Portal</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .lead-detail-page { padding: 2rem; max-width: 1200px; margin: 0 auto; }
    .back-link { display: inline-flex; align-items: center; gap: 0.4rem; color: #6B7280; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 0.9rem; margin-bottom: 1.5rem; transition: color 0.2s; }
    .back-link:hover { color: #D4AF37; }
    .lead-header { background: linear-gradient(135deg, #0A1628 0%, #1a2a40 100%); color: #FAFAF7; padding: 2rem 2.5rem; border-radius: 12px; border-top: 4px solid #D4AF37; margin-bottom: 1.5rem; }
    .lead-name-big { font-family: 'Playfair Display', serif; font-size: 2.2rem; margin-bottom: 0.5rem; color: #FAFAF7; }
    .lead-phone-big { color: #D4AF37; font-size: 1.1rem; margin-bottom: 1rem; }
    .status-badge { display: inline-block; padding: 0.4rem 1rem; border-radius: 999px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; }
    .status-hot { background: #FEE2E2; color: #991B1B; }
    .status-warm { background: #FEF3C7; color: #92400E; }
    .status-cold { background: #DBEAFE; color: #1E40AF; }
    .status-converted { background: #D1FAE5; color: #065F46; }
    .status-lost { background: #E5E7EB; color: #374151; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-top: 1.25rem; }
    .info-block { background: rgba(255,255,255,0.08); padding: 1rem 1.25rem; border-radius: 8px; border-left: 3px solid #D4AF37; }
    .info-label { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7; margin-bottom: 0.3rem; }
    .info-value { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; }
    .section-card { background: #FFFFFF; padding: 1.5rem 2rem; border-radius: 10px; margin-bottom: 1.25rem; box-shadow: 0 2px 8px rgba(10,22,40,0.05); }
    .section-title { font-family: 'Playfair Display', serif; font-size: 1.3rem; color: #0A1628; margin-bottom: 1rem; padding-bottom: 0.7rem; border-bottom: 2px solid #D4AF37; }
    .field-row { display: flex; margin-bottom: 0.8rem; padding: 0.5rem 0; border-bottom: 1px solid #F3F4F6; }
    .field-label { font-weight: 600; color: #6B7280; min-width: 180px; }
    .field-value { color: #0A1628; flex: 1; }
    .actions-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }
    .btn { padding: 0.7rem 1.5rem; min-height: 44px; box-sizing: border-box; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; transition: all 0.2s; }
    .btn-primary { background: #D4AF37; color: #0A1628; }
    .btn-primary:hover { background: #B8961F; }
    .btn-secondary { background: transparent; color: #0A1628; border: 1px solid #0A1628; }
    .btn-secondary:hover { background: #0A1628; color: #FAFAF7; }
    .btn-danger { background: #dc2626; color: #fff; border: none; cursor: pointer; font-family: inherit; }
    .btn-danger:hover { background: #b91c1c; }
    .match-btn { background: linear-gradient(135deg, #D4AF37 0%, #B8961F 100%); color: #0A1628; padding: 0.9rem 1.8rem; border-radius: 8px; text-decoration: none; font-weight: 700; box-shadow: 0 4px 12px rgba(212,175,55,0.3); }
    .match-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(212,175,55,0.4); }
  </style>
</head>
<body>
  <%- include('layout/sidebar') %>
  <%- include('layout/topbar') %>
  <main class="main-content">
    <div class="lead-detail-page">
      <a href="<%= backFor('leads') %>" class="back-link">← Back to All Leads</a>

      <!-- HEADER CARD -->
      <div class="lead-header">
        <h1 class="lead-name-big"><%= lead.name || 'Unknown Lead' %></h1>
        <div class="lead-phone-big">📞 <%= lead.phone || 'No phone' %></div>
        <span class="status-badge status-<%= (lead.status || 'cold') %>"><%= (lead.status || 'cold').toUpperCase() %></span>

        <div class="info-grid">
          <div class="info-block">
            <span class="info-label">Email</span>
            <span class="info-value"><%= lead.email || 'N/A' %></span>
          </div>
          <div class="info-block">
            <span class="info-label">Source</span>
            <span class="info-value"><%= (lead.source || 'other').replace(/_/g, ' ') %></span>
          </div>
          <div class="info-block">
            <span class="info-label">Budget</span>
            <span class="info-value"><%= lead.budget || 'Not specified' %></span>
          </div>
          <div class="info-block">
            <span class="info-label">Requirement</span>
            <span class="info-value"><%= lead.requirement || 'Not specified' %></span>
          </div>
          <div class="info-block">
            <span class="info-label">Location</span>
            <span class="info-value"><%= lead.location || 'Not specified' %></span>
          </div>
          <% if (lead.closure_probability) { %>
          <div class="info-block">
            <span class="info-label">Closure Probability</span>
            <span class="info-value"><%= lead.closure_probability %>%</span>
          </div>
          <% } %>
        </div>
      </div>

      <!-- CLIENT PROFILE (027) -->
      <%- include('partials/lead-client-profile-view') %>

      <!-- QUICK ACTIONS -->
      <div class="section-card">
        <div class="section-title">Quick Actions</div>
        <div class="actions-row">
          <a href="/leads/<%= lead.lead_id %>/edit" class="btn btn-primary">✏️ Edit Lead</a>
          <a href="/feedback?lead_id=<%= lead.lead_id %>" class="btn btn-primary">💬 Add Feedback</a>
          <form action="/leads/<%= lead.lead_id %>/delete" method="POST" style="display:inline;"
                onsubmit="return confirm('Request deletion of this lead? It will be sent to the Boss for approval.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">🗑 Delete Lead</button>
          </form>
          <a href="/closure?lead_id=<%= lead.lead_id %>" class="btn btn-primary">✅ Mark Closure</a>
          <% 
            // Build property match URL based on lead's preferences
            var matchUrl = '/projects?';
            var params = [];
            if (lead.location) { params.push('search=' + encodeURIComponent(lead.location)); }
            if (lead.budget) {
              var budgetMatch = (lead.budget || '').toLowerCase().match(/(\d+(?:\.\d+)?)\s*(cr|l)/);
              if (budgetMatch) {
                var maxLakhs = parseFloat(budgetMatch[1]) * (budgetMatch[2] === 'cr' ? 100 : 1);
                params.push('max_lakhs=' + Math.round(maxLakhs * 1.2));
              }
            }
            matchUrl += params.join('&');
          %>
          <a href="<%= matchUrl %>" class="match-btn">🎯 Find Matching Properties</a>
        </div>
      </div>

      <!-- DETAILS -->
      <div class="section-card">
        <div class="section-title">Lead Information</div>
        <div class="field-row">
          <span class="field-label">Last Feedback:</span>
          <span class="field-value"><%= lead.last_feedback || 'No feedback yet' %></span>
        </div>
        <div class="field-row">
          <span class="field-label">Next Action:</span>
          <span class="field-value"><%= lead.next_action || 'Not scheduled' %></span>
        </div>
        <div class="field-row">
          <span class="field-label">Next Action Date:</span>
          <span class="field-value">
            <% if (lead.next_action_date) { %>
              <%= new Date(lead.next_action_date).toLocaleDateString('en-IN') %>
            <% } else { %>
              Not scheduled
            <% } %>
          </span>
        </div>
        <div class="field-row">
          <span class="field-label">Site Visit Date:</span>
          <span class="field-value">
            <% if (lead.site_visit_date) { %>
              <%= new Date(lead.site_visit_date).toLocaleDateString('en-IN') %>
            <% } else { %>
              Not scheduled
            <% } %>
          </span>
        </div>
        <div class="field-row">
          <span class="field-label">Lead Created:</span>
          <span class="field-value">
            <% if (lead.created_at) { %>
              <%= new Date(lead.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            <% } else { %>
              Unknown
            <% } %>
          </span>
        </div>
        <div class="field-row">
          <span class="field-label">External ID:</span>
          <span class="field-value"><%= lead.external_id || 'N/A' %></span>
        </div>
      </div>

      <!-- FEEDBACK HISTORY (if passed) -->
      <% if (typeof feedbackHistory !== 'undefined' && feedbackHistory && feedbackHistory.length > 0) { %>
      <div class="section-card">
        <div class="section-title">Feedback History (<%= feedbackHistory.length %>)</div>
        <% feedbackHistory.forEach(function(fb) { %>
          <div style="padding: 1rem; margin-bottom: 0.75rem; background: #FAFAF7; border-radius: 6px; border-left: 3px solid #D4AF37;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <strong style="color: #0A1628;">
                <% if (fb.rating) { %>
                  <span style="color: #D4AF37;"><%= '★'.repeat(fb.rating) %></span>
                <% } %>
              </strong>
              <span style="color: #9CA3AF; font-size: 0.85rem;">
                <%= new Date(fb.created_at).toLocaleString('en-IN') %>
              </span>
            </div>
            <div style="color: #4B5563; line-height: 1.5;"><%= fb.comments || '—' %></div>
          </div>
        <% }); %>
      </div>
      <% } %>

      <!-- SUGGESTED PROPERTIES (AI Day, Feature 1 — deterministic matcher) -->
      <div class="match-panel"
           data-matches-url="/leads/<%= lead.lead_id %>/matches">
        <div class="mp-head">
          <h3>Suggested Properties</h3>
          <button type="button" class="mp-btn" data-find>Find Matches</button>
        </div>
        <div class="mp-sub">Best-fit units for this client’s budget, location and configuration — scored /100.</div>
        <div data-results></div>
      </div>
      <script src="/js/matcher-panel.js"></script>

    </div>
  </main>
</body>
</html>
