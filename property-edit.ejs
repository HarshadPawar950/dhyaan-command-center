<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> — Dhyaan Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --gold: #D4AF37; --gold-soft: #E8C766; --gold-dark: #B8941F;
            --navy: #0A1628; --navy-2: #142238;
            --offwhite: #FAFAF7; --beige: #F4EFE6;
            --text: #1a1a1a; --muted: #6b6b6b;
            --border: rgba(10, 22, 40, 0.08);
            --shadow: 0 4px 24px rgba(10, 22, 40, 0.06);
            --green: #16a34a; --red: #dc2626; --amber: #d97706; --blue: #2563eb;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--offwhite); color: var(--text); min-height: 100vh; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; font-weight: 600; color: var(--navy); }
        .topbar { background: #fff; border-bottom: 1px solid var(--border); padding: 14px 28px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(10,22,40,0.03); }
        .topbar-left { display: flex; align-items: center; gap: 12px; }
        .logo-mark { width: 36px; height: 36px; border-radius: 8px; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); color: var(--navy); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center; }
        .brand-text { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 17px; color: var(--navy); }
        .brand-sub { font-size: 10px; letter-spacing: 2px; color: var(--gold-dark); text-transform: uppercase; }
        .topbar-right { display: flex; align-items: center; gap: 14px; }
        .user-pill { display: flex; align-items: center; gap: 10px; background: var(--beige); padding: 6px 12px; border-radius: 999px; }
        .avatar-mini { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); color: var(--navy); display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 12px; }
        .user-name { font-size: 13px; font-weight: 600; color: var(--navy); }
        .logout-btn { padding: 8px 14px; font-size: 12px; font-weight: 600; background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; }
        .logout-btn:hover { color: var(--navy); background: var(--beige); }

        .page-body { max-width: 900px; margin: 30px auto; padding: 0 24px; }
        .breadcrumb { font-size: 13px; color: var(--muted); margin-bottom: 14px; }
        .breadcrumb a { color: var(--gold-dark); text-decoration: none; font-weight: 600; }
        .breadcrumb a:hover { text-decoration: underline; }

        .page-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%); color: var(--offwhite); padding: 26px 32px; border-radius: 16px; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
        .page-hero::before { content: ""; position: absolute; top: -50%; right: -10%; width: 350px; height: 350px; background: radial-gradient(circle, rgba(212,175,55,0.18) 0%, transparent 70%); pointer-events: none; }
        .page-hero h1 { color: var(--offwhite); font-size: 28px; margin-bottom: 4px; }
        .page-hero p { color: rgba(250,250,247,0.7); font-size: 14px; }
        .page-hero .code-pill { display: inline-block; margin-top: 10px; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold); font-weight: 700; }

        .flash { padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 13px; font-weight: 500; }
        .flash-success { background: rgba(22,163,74,0.10); color: var(--green); border: 1px solid rgba(22,163,74,0.20); }
        .flash-error   { background: rgba(220,38,38,0.10); color: var(--red);   border: 1px solid rgba(220,38,38,0.20); }

        .form-card { background: #fff; border-radius: 14px; border: 1px solid var(--border); box-shadow: var(--shadow); overflow: hidden; margin-bottom: 20px; }
        .section-head { padding: 14px 24px; background: var(--beige); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
        .section-head .icon { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); color: var(--navy); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
        .section-head h3 { font-size: 16px; }
        .section-body { padding: 22px 24px; }
        .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 22px; }
        @media (max-width: 700px) { .field-grid { grid-template-columns: 1fr; } }
        .field-full { grid-column: 1 / -1; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); font-weight: 600; }
        .field label .req { color: var(--red); margin-left: 3px; }
        .field input, .field select, .field textarea { font-family: inherit; font-size: 14px; padding: 11px 14px; border: 1px solid var(--border); border-radius: 9px; background: var(--offwhite); color: var(--text); outline: none; transition: border-color 0.15s ease, background 0.15s ease; }
        .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold); background: #fff; box-shadow: 0 0 0 3px rgba(212,175,55,0.12); }
        .field textarea { resize: vertical; min-height: 80px; line-height: 1.5; }
        .field .hint { font-size: 11px; color: var(--muted); margin-top: 2px; }

        .action-bar { display: flex; justify-content: flex-end; gap: 12px; padding: 20px 0; position: sticky; bottom: 0; background: linear-gradient(to top, var(--offwhite) 70%, transparent); }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; border-radius: 10px; font-family: inherit; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; transition: all 0.15s ease; }
        .btn-cancel { background: transparent; color: var(--muted); border: 1px solid var(--border); }
        .btn-cancel:hover { background: var(--beige); color: var(--navy); }
        .btn-save { background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); color: var(--navy); box-shadow: 0 4px 14px rgba(212,175,55,0.30); }
        .btn-save:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(212,175,55,0.40); }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="topbar-left">
            <div class="logo-mark">D</div>
            <div>
                <div class="brand-text">Dhyaan</div>
                <div class="brand-sub">Employee Portal</div>
            </div>
        </div>
        <div class="topbar-right">
            <div class="user-pill">
                <div class="avatar-mini"><%= (user.name || '?').charAt(0).toUpperCase() %></div>
                <div class="user-name"><%= user.name %></div>
            </div>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>
    </div>

    <div class="page-body">

        <div class="breadcrumb">
            <a href="<%= propsBase %>/<%= propertyId %>">← Back to Property</a>
        </div>

        <div class="page-hero">
            <h1>Edit Project</h1>
            <p>Update project details — changes are logged in history.</p>
            <% if (externalId) { %><div class="code-pill"><%= externalId %></div><% } %>
        </div>

        <% if (flash) { %>
            <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
        <% } %>

        <form method="POST" action="/projects/<%= propertyId %>/edit" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Dhyaan project SHEET — mirrors the workbook line by line.
                 Category FIRST; groups 1->7 render in order once a category is ticked.
                 Amenities render inline in Group 5; legacy/infra fields (maps, tier,
                 price, bhk, location advantages...) are hidden-preserve inputs in the
                 partial so a sheet-only save never nulls them. Media managers stay below. -->

            <%- include('partials/project-sheet-fields') %>

            <div class="action-bar">
                <a href="<%= propsBase %>/<%= propertyId %>" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-save">💾 Update Property</button>
            </div>

        </form>

        <!-- PROPERTY MEDIA (Photos | Videos | Brochures) — properties.manage gated -->
        <% if (canManageMedia) { %>
        <style>
            .mm-card{background:#fff;border:1px solid rgba(10,22,40,0.08);border-radius:12px;padding:20px 24px;margin-top:24px;box-shadow:0 2px 12px rgba(10,22,40,0.06);}
            .mm-card h2{font-family:'Playfair Display',serif;color:#0A1628;font-size:18px;margin:0 0 4px;}
            .mm-sec{margin-top:18px;padding-top:16px;border-top:1px solid rgba(10,22,40,0.06);}
            .mm-sec:first-of-type{border-top:none;padding-top:0;}
            .mm-sec h3{font-size:14px;color:#0A1628;margin:0 0 12px;text-transform:uppercase;letter-spacing:.5px;}
            .mm-grid{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px;}
            .mm-tile{position:relative;width:130px;border-radius:8px;overflow:hidden;border:1px solid rgba(10,22,40,0.1);background:var(--offwhite);}
            .mm-thumb{width:130px;height:96px;object-fit:cover;display:block;background:#0A1628;}
            .mm-doc{width:130px;height:96px;display:flex;align-items:center;justify-content:center;font-size:34px;background:linear-gradient(135deg,#142238,#0A1628);color:#D4AF37;}
            .mm-name{font-size:11px;color:#6b6b6b;padding:5px 7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
            .mm-actions{display:flex;gap:1px;}
            .mm-actions a,.mm-actions button{flex:1;border:none;padding:6px 0;font-size:11px;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;}
            .mm-dl{background:rgba(212,175,55,0.16);color:#B8941F;}
            .mm-rm{background:rgba(220,38,38,0.10);color:#dc2626;}
            .mm-empty{color:#6b6b6b;font-size:13px;margin:0 0 12px;}
            .mm-up{color:#6b6b6b;font-size:12px;margin:6px 0 10px;}
        </style>
        <div class="mm-card">
            <h2>Property Media</h2>
            <p style="color:#6b6b6b;font-size:12px;margin:0;">Photos, walkthrough videos and brochures for the detail page.</p>

            <!-- PHOTOS -->
            <div class="mm-sec">
                <h3>📷 Photos</h3>
                <% if (images && images.length) { %>
                    <div class="mm-grid">
                        <% images.forEach(function(m){ %>
                            <div class="mm-tile">
                                <img class="mm-thumb" src="<%= m.file_path %>" alt="">
                                <div class="mm-name" title="<%= m.original_name || '' %>"><%= m.original_name || 'photo' %></div>
                                <div class="mm-actions">
                                    <a class="mm-dl" href="<%= m.file_path %>" download="<%= m.original_name || '' %>">Download</a>
                                    <form method="POST" action="/projects/<%= propertyId %>/images/<%= m.image_id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>" onsubmit="return confirm('Remove this photo?');" style="margin:0;flex:1;">
                                        <button type="submit" class="mm-rm">Remove</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><p class="mm-empty">No photos yet.</p><% } %>
                <form method="POST" action="/projects/<%= propertyId %>/images?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
                    <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required style="display:block;margin-bottom:6px;">
                    <div class="mm-up">JPG, PNG or WebP · up to 10 GB each · <strong>max 10 photos</strong>.</div>
                    <button type="submit" class="btn btn-save">⬆ Upload Photos</button>
                </form>
            </div>

            <!-- VIDEOS -->
            <div class="mm-sec">
                <h3>🎬 Videos</h3>
                <% if (videos && videos.length) { %>
                    <div class="mm-grid">
                        <% videos.forEach(function(m){ %>
                            <div class="mm-tile">
                                <video class="mm-thumb" src="<%= m.file_path %>" preload="metadata" muted></video>
                                <div class="mm-name" title="<%= m.original_name || '' %>"><%= m.original_name || 'video' %></div>
                                <div class="mm-actions">
                                    <a class="mm-dl" href="<%= m.file_path %>" download="<%= m.original_name || '' %>">Download</a>
                                    <form method="POST" action="/projects/<%= propertyId %>/images/<%= m.image_id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>" onsubmit="return confirm('Remove this video?');" style="margin:0;flex:1;">
                                        <button type="submit" class="mm-rm">Remove</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><p class="mm-empty">No videos yet.</p><% } %>
                <form method="POST" action="/projects/<%= propertyId %>/videos?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
                    <input type="file" name="videos" accept="video/mp4,video/webm,video/quicktime" multiple required style="display:block;margin-bottom:6px;">
                    <div class="mm-up">MP4, WebM or MOV · up to 10 GB each · <strong>max 10 videos</strong>.</div>
                    <button type="submit" class="btn btn-save">⬆ Upload Videos</button>
                </form>
            </div>

            <!-- BROCHURES -->
            <div class="mm-sec">
                <h3>📄 Brochures (PDF)</h3>
                <% if (brochures && brochures.length) { %>
                    <div class="mm-grid">
                        <% brochures.forEach(function(m){ %>
                            <div class="mm-tile">
                                <a href="<%= m.file_path %>" target="_blank" rel="noopener" class="mm-doc" style="text-decoration:none;">📄</a>
                                <div class="mm-name" title="<%= m.original_name || '' %>"><%= m.original_name || 'brochure.pdf' %></div>
                                <div class="mm-actions">
                                    <a class="mm-dl" href="<%= m.file_path %>" download="<%= m.original_name || '' %>">Download</a>
                                    <form method="POST" action="/projects/<%= propertyId %>/images/<%= m.image_id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>" onsubmit="return confirm('Remove this brochure?');" style="margin:0;flex:1;">
                                        <button type="submit" class="mm-rm">Remove</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><p class="mm-empty">No brochures yet.</p><% } %>
                <form method="POST" action="/projects/<%= propertyId %>/brochures?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
                    <input type="file" name="brochures" accept="application/pdf" multiple required style="display:block;margin-bottom:6px;">
                    <div class="mm-up">PDF only · up to 10 GB each · <strong>max 10 brochures</strong>.</div>
                    <button type="submit" class="btn btn-save">⬆ Upload Brochures</button>
                </form>
            </div>

            <div class="mm-sec">
                <h3>📐 Floor Plans</h3>
                <% var _fp = (typeof floorPlans !== 'undefined' && floorPlans) ? floorPlans : []; %>
                <% if (_fp.length) { %>
                    <div class="mm-grid">
                        <% _fp.forEach(function(m){ %>
                            <div class="mm-tile">
                                <a href="<%= m.file_path %>" target="_blank" rel="noopener"><img class="mm-thumb" src="<%= m.file_path %>" alt="floor plan"></a>
                                <div class="mm-name" title="<%= m.original_name || '' %>"><%= m.caption || m.original_name || 'floor plan' %></div>
                                <div class="mm-actions">
                                    <a class="mm-dl" href="<%= m.file_path %>" download="<%= m.original_name || '' %>">Download</a>
                                    <form method="POST" action="/projects/<%= propertyId %>/images/<%= m.image_id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>" onsubmit="return confirm('Remove this floor plan?');" style="margin:0;flex:1;">
                                        <button type="submit" class="mm-rm">Remove</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %><p class="mm-empty">No floor plans yet.</p><% } %>
                <form method="POST" action="/projects/<%= propertyId %>/floorplans?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
                    <input type="file" name="floorplans" accept="image/jpeg,image/png,image/webp" multiple required style="display:block;margin-bottom:6px;">
                    <div class="mm-up">JPG, PNG or WebP · up to 10 GB each · <strong>max 10 floor plans</strong>.</div>
                    <button type="submit" class="btn btn-save">⬆ Upload Floor Plans</button>
                </form>
            </div>
        </div>
        <% } %>

    </div>

</body>
</html>
