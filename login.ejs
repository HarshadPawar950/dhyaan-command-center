<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Dhyaan Realty</title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Explicit design-system link (also pulled via style.css @import); loads
       before the inline <style> below so the approved login look wins. -->
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --navy:#0A1628; --gold:#D4AF37; --gold-dark:#B8941F; --cream:#F4EFE6; --muted:#8892a0; }
    * { box-sizing: border-box; }
    body { margin:0; font-family:'Inter',sans-serif; color:var(--navy); background:var(--cream); }
    .login-page { min-height:100vh; display:flex; flex-direction:column; }
    .login-split { flex:1; display:flex; min-height:0; }

    /* ---------- LEFT (navy + skyline) ---------- */
    .login-left { flex:1.15; position:relative; background:var(--navy); overflow:hidden;
                  display:flex; flex-direction:column; padding:48px 56px; }
    .login-left .skyline { position:absolute; left:0; right:0; bottom:0; height:56%;
                  background:url('/img/skyline.png') center bottom / cover no-repeat; z-index:0; }
    .login-left .skyline::before { content:''; position:absolute; inset:0;
                  background:linear-gradient(to bottom, var(--navy) 0%, rgba(10,22,40,0.55) 30%, rgba(10,22,40,0) 70%); }
    .login-left .brandmark, .login-left .lead { position:relative; z-index:1; }
    .brandmark { display:flex; align-items:center; gap:14px; }
    .brandmark .brand-logo { height:100px; width:auto; max-width:100%; object-fit:contain; flex-shrink:0; display:block; }
    .lead { margin-top:auto; margin-bottom:9%; }
    .lead h1 { font-family:'Playfair Display',serif; font-weight:700; color:#fff; font-size:42px; line-height:1.15; margin:0; }
    .lead h1 .gold { color:var(--gold); display:block; }
    .lead .divider { width:64px; height:3px; background:var(--gold); border-radius:2px; margin:28px 0 22px; }
    .lead p { color:#c8cfda; font-size:14px; line-height:1.8; margin:0; }

    /* ---------- RIGHT (cream + card) ---------- */
    .login-right { flex:0.85; position:relative; display:flex; align-items:center; justify-content:center;
                   padding:40px 32px; background:var(--cream);
                   background-image:radial-gradient(circle at top right, rgba(212,175,55,0.10), transparent 42%); }
    .login-card { width:100%; max-width:420px; background:#fff; border-radius:18px;
                  box-shadow:0 18px 50px rgba(10,22,40,0.12); padding:52px 46px 48px; }
    .card-logo { display:block; height:120px; width:auto; max-width:100%; object-fit:contain; margin:0 auto 30px; }
    .login-card h2 { font-family:'Playfair Display',serif; font-weight:700; color:var(--navy);
             font-size:28px; text-align:center; margin:0 0 8px; }
    .login-card .sub { text-align:center; color:var(--muted); font-size:13.5px; margin:0 0 34px; }

    .field { margin-bottom:22px; }
    .field label { display:block; font-size:13px; font-weight:600; color:#3a4557; margin-bottom:7px; }
    .input-wrap { position:relative; }
    .input-wrap .lead-icon { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none; }
    .input-wrap input { width:100%; padding:12px 14px 12px 42px; border:1px solid #e2e5ea; border-radius:10px;
             font-size:14px; font-family:inherit; color:var(--navy); background:#fdfdfc; transition:border-color .15s, box-shadow .15s; }
    .input-wrap input:focus { outline:none; border-color:var(--gold); box-shadow:0 0 0 3px rgba(212,175,55,0.18); }
    .input-wrap .eye { position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none;
             border:none; padding:6px; cursor:pointer; color:var(--muted); display:flex; }

    .forgot-row { display:flex; justify-content:flex-end; margin:2px 0 28px; }
    .forgot { font-size:13px; color:var(--gold-dark); font-weight:600; text-decoration:none; }
    .forgot:hover { text-decoration:underline; }

    .btn-signin { width:100%; padding:13px; border:none; border-radius:10px; cursor:pointer;
             background:linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%); color:var(--navy);
             font-family:inherit; font-size:15px; font-weight:700; letter-spacing:.3px; box-shadow:0 6px 16px rgba(212,175,55,0.32); transition:filter .15s, transform .05s; }
    .btn-signin:hover { filter:brightness(1.05); }
    .btn-signin:active { transform:translateY(1px); }

    /* flash messages (partial) sit above the form */
    .login-card .alert { margin-bottom:16px; }

    /* ---------- FOOTER ---------- */
    .login-footer { background:var(--navy); color:#b9c2cf; text-align:center; font-size:12.5px; padding:14px 16px; letter-spacing:.2px; }

    /* ---------- responsive ---------- */
    @media (max-width: 880px) {
      .login-split { flex-direction:column; }
      .login-left { flex:none; min-height:280px; padding:34px 34px; }
      .login-left .skyline { height:48%; }
      .lead h1 { font-size:32px; }
      .login-right { flex:none; padding:34px 22px; }
    }
  </style>
</head>
<body>
  <div class="login-page">
    <div class="login-split">

      <!-- LEFT: navy + skyline -->
      <div class="login-left">
        <div class="skyline"></div>
        <div class="brandmark">
          <img class="brand-logo" src="/img/dhyaan-logo.png?v=ac9fbfc" alt="Dhyaan Enterprises">
        </div>
        <div class="lead">
          <h1>Premium Real Estate <span class="gold">Portal</span></h1>
          <div class="divider"></div>
          <p>One Portal. Complete Control.<br>Smarter Deals. Stronger Relationships.</p>
        </div>
      </div>

      <!-- RIGHT: cream + sign-in card -->
      <div class="login-right">
        <div class="login-card">
          <img class="card-logo" src="/img/dhyaan-logo.png?v=ac9fbfc" alt="Dhyaan Enterprises">
          <h2>Welcome Back!</h2>
          <p class="sub">Sign in to continue to your dashboard</p>

          <%- include('layout/messages') %>

          <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="field">
              <label for="email">Email Address</label>
              <div class="input-wrap">
                <span class="lead-icon">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <input type="email" id="email" name="email" required placeholder="Enter your email" autocomplete="username">
              </div>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <div class="input-wrap">
                <span class="lead-icon">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input type="password" id="password" name="password" required placeholder="Enter your password" autocomplete="current-password">
                <button type="button" class="eye" id="togglePw" aria-label="Show password">
                  <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <div class="forgot-row">
              <a class="forgot" href="#">Forgot Password?</a>
            </div>

            <button type="submit" class="btn-signin">Sign In</button>
          </form>
        </div>
      </div>

    </div>
    <footer class="login-footer">&copy; 2026 Dhyaan Enterprises. All rights reserved.</footer>
  </div>

  <script>
    // Password visibility toggle (cosmetic; no data leaves the field).
    (function () {
      var btn = document.getElementById('togglePw'),
          pw = document.getElementById('password'),
          icon = document.getElementById('eyeIcon');
      if (!btn || !pw) return;
      btn.addEventListener('click', function () {
        var show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        icon.innerHTML = show
          ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
          : '<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>';
      });
    })();
  </script>
</body>
</html>
