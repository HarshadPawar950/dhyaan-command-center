<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &mdash; Dhyaan</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0;} body{font-family:'Inter',sans-serif;background:#FAFAF7;color:#1a1a1a;}
    .wrap{max-width:820px;margin:0 auto;padding:28px 20px;}
    .hero{background:linear-gradient(135deg,#0A1628,#142238);color:#fff;border-radius:16px;padding:24px 28px;margin-bottom:20px;}
    .hero h1{font-family:'Playfair Display',serif;font-size:26px;} .hero p{color:rgba(250,250,247,.7);font-size:14px;margin-top:4px;}
    .back{display:inline-block;margin-bottom:14px;color:#2563eb;text-decoration:none;font-size:13px;font-weight:600;}
    .panel{background:#fff;border:1px solid rgba(10,22,40,.08);border-radius:14px;box-shadow:0 4px 24px rgba(10,22,40,.06);overflow:hidden;}
    table{width:100%;border-collapse:collapse;font-size:14px;} th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#6b6b6b;padding:12px 16px;border-bottom:2px solid rgba(10,22,40,.1);background:#F4EFE6;} th.r,td.r{text-align:right;}
    td{padding:13px 16px;border-bottom:1px solid rgba(10,22,40,.06);} .mono{font-variant-numeric:tabular-nums;}
    .btn{font-size:13px;font-weight:600;padding:8px 14px;border-radius:8px;border:none;cursor:pointer;text-decoration:none;background:#D4AF37;color:#0A1628;display:inline-flex;}
    .empty{text-align:center;color:#6b6b6b;padding:40px;font-size:14px;}
    .net{font-weight:700;color:#0A1628;}
  </style>
</head>
<body>
  <%- (typeof topbarHtml!=='undefined')?topbarHtml:'' %>
  <div class="wrap">
    <a class="back" href="/dashboard">← Dashboard</a>
    <div class="hero"><h1>My Payslips</h1><p>Your finalized monthly payslips. Only you can see these.</p></div>
    <div class="panel">
      <table>
        <thead><tr><th>Month</th><th class="r">Gross</th><th class="r">Incentive</th><th class="r">Deductions</th><th class="r">Net Pay</th><th></th></tr></thead>
        <tbody>
          <% if (payslips && payslips.length) { %>
            <% payslips.forEach(function(p){ var m=new Date(p.period_month).toLocaleDateString('en-IN',{month:'long',year:'numeric'}); %>
              <tr>
                <td class="mono"><%= m %></td>
                <td class="r mono">₹<%= Number(p.gross).toLocaleString('en-IN') %></td>
                <td class="r mono">₹<%= Number(p.incentive_amount).toLocaleString('en-IN') %></td>
                <td class="r mono">₹<%= Number(p.total_deductions).toLocaleString('en-IN') %></td>
                <td class="r mono net">₹<%= Number(p.net_pay).toLocaleString('en-IN') %></td>
                <td><a class="btn" href="/payslips/<%= p.payslip_id %>/pdf" target="_blank">Download</a></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="empty">No payslips yet. They appear here once payroll for the month is finalized.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
