<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (typeof title !== 'undefined' && title) ? title : 'Error' %> | Dhyaan Realty</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0A1628 0%, #1a2a40 100%); font-family: 'Inter', sans-serif; }
    .err-card { background: #FAFAF7; border-top: 4px solid #D4AF37; border-radius: 12px; padding: 3rem 3.5rem; max-width: 520px; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .err-code { font-family: 'Playfair Display', serif; font-size: 5rem; color: #D4AF37; font-weight: 700; line-height: 1; margin-bottom: 0.5rem; }
    .err-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #0A1628; margin-bottom: 0.75rem; }
    .err-message { color: #6B7280; margin-bottom: 2rem; line-height: 1.6; }
    .home-btn { display: inline-block; background: #D4AF37; color: #0A1628; padding: 0.8rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600; transition: background 0.2s; }
    .home-btn:hover { background: #B8961F; }
  </style>
</head>
<body>
  <%
    var _u = (typeof user !== 'undefined') ? user : null;
    var _home = (typeof homePath !== 'undefined' && homePath) ? homePath
              : (_u && (_u.access_role === 'admin' || _u.access_role === 'super_admin') ? '/admin/dashboard'
              : (_u ? '/dashboard' : '/login'));
    var _label = _home === '/login' ? 'Go to Login'
              : (_home === '/admin/dashboard' ? 'Back to Admin Dashboard'
              : (_home === '/hr/dashboard' ? 'Back to HR Dashboard' : 'Back to Dashboard'));
    var _code = (typeof code !== 'undefined' && code) ? code : 500;
    var _title = (typeof title !== 'undefined' && title) ? title : 'Something went wrong';
    var _msg = (typeof message !== 'undefined' && message) ? message : 'An unexpected error occurred.';
  %>
  <div class="err-card">
    <div class="err-code"><%= _code %></div>
    <h1 class="err-title"><%= _title %></h1>
    <p class="err-message"><%= _msg %></p>
    <a href="<%= _home %>" class="home-btn">← <%= _label %></a>
  </div>
</body>
</html>
