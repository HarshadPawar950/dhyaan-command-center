<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> — Dhyaan Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root{--gold:#D4AF37;--gold-soft:#E8C766;--gold-dark:#B8941F;--navy:#0A1628;--navy-2:#142238;--offwhite:#FAFAF7;--beige:#F4EFE6;--text:#1a1a1a;--muted:#6b6b6b;--border:rgba(10,22,40,0.08);--shadow:0 4px 24px rgba(10,22,40,0.06);--green:#16a34a;--blue:#2563eb;}
        *{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:var(--offwhite);color:var(--text);min-height:100vh;}
        h1,h2,h3{font-family:'Playfair Display',serif;font-weight:600;color:var(--navy);}
        .topbar{background:#fff;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;justify-content:space-between;align-items:center;}
        .back-link{color:var(--gold-dark);font-size:13px;font-weight:600;text-decoration:none;}
        .user-pill{display:flex;align-items:center;gap:10px;background:var(--beige);padding:6px 12px;border-radius:999px;}
        .avatar-mini{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-soft));color:var(--navy);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;font-size:12px;}
        .user-name{font-size:13px;font-weight:600;color:var(--navy);}
        .logout-btn{padding:8px 14px;font-size:12px;font-weight:600;background:transparent;color:var(--muted);border:1px solid var(--border);border-radius:8px;text-decoration:none;}
        .topbar-right{display:flex;align-items:center;gap:14px;}
        .page-body{max-width:1100px;margin:24px auto;padding:0 24px;}
        .u-hero{background:linear-gradient(135deg,var(--navy),var(--navy-2));color:var(--offwhite);padding:30px 34px;border-radius:16px;margin-bottom:22px;position:relative;overflow:hidden;box-shadow:var(--shadow);}
        .u-hero::before{content:"";position:absolute;top:-50%;right:-10%;width:380px;height:380px;background:radial-gradient(circle,rgba(212,175,55,0.18),transparent 70%);}
        .u-hero .badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;position:relative;z-index:2;}
        .cat-chip{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--navy);background:linear-gradient(135deg,var(--gold),var(--gold-soft));font-weight:700;padding:5px 12px;border-radius:6px;}
        .status-badge{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--gold-soft);border:1px solid rgba(212,175,55,0.4);font-weight:700;padding:5px 12px;border-radius:6px;}
        .type-chip{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:rgba(250,250,247,0.85);background:rgba(255,255,255,0.10);font-weight:700;padding:5px 12px;border-radius:6px;}
        .u-hero h1{color:var(--offwhite);font-size:30px;margin-bottom:6px;position:relative;z-index:2;}
        .u-hero .sub{color:rgba(250,250,247,0.75);font-size:14px;position:relative;z-index:2;}
        .price-row{display:flex;gap:18px;flex-wrap:wrap;margin-top:18px;position:relative;z-index:2;align-items:center;}
        .price-box{background:rgba(255,255,255,0.08);border:1px solid rgba(212,175,55,0.25);border-radius:12px;padding:14px 20px;}
        .price-box .lbl{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(250,250,247,0.6);font-weight:700;margin-bottom:4px;}
        .price-box .val{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:var(--gold-soft);}
        .neg-badge{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#0A1628;background:linear-gradient(135deg,var(--gold),var(--gold-soft));padding:4px 10px;border-radius:5px;}
        .edit-btn{margin-left:auto;background:rgba(255,255,255,0.12);color:var(--offwhite);border:1px solid rgba(212,175,55,0.35);border-radius:9px;padding:9px 16px;font-size:13px;font-weight:600;text-decoration:none;}
        .panel{background:#fff;border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow);overflow:hidden;margin-bottom:22px;}
        .panel-head{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
        .panel-head h2{font-size:17px;}
        .panel-body{padding:20px 22px;}
        .facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px 22px;}
        .fact .lbl{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--muted);font-weight:600;margin-bottom:3px;}
        .fact .val{font-size:15px;color:var(--navy);font-weight:600;white-space:pre-line;}
        .chips{display:flex;flex-wrap:wrap;gap:8px;}
        .chip{font-size:12px;font-weight:600;color:var(--navy);background:var(--beige);border-radius:999px;padding:6px 14px;}
        .pcard{display:flex;align-items:center;gap:14px;text-decoration:none;}
        .pcard .mono{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold-soft));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;color:var(--navy);font-size:22px;flex-shrink:0;}
        .pcard .nm{font-weight:700;color:var(--navy);font-size:16px;}
        .pcard .mt{font-size:12px;color:var(--muted);}
        .gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;}
        .gallery img,.gallery video{width:100%;height:130px;object-fit:cover;border-radius:10px;border:1px solid var(--border);display:block;}
        .gsub{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);font-weight:700;margin:14px 0 8px;}
        /* BUG B: managers get the admin sidebar (below), which does not inject a
           content offset the way the employee sidebar does — pin it here so the
           page lays out correctly under EITHER sidebar. */
        .main-content{margin-left:260px;}
        @media (max-width:900px){.main-content{margin-left:0;}}
        @media (max-width:600px){.u-hero h1{font-size:24px;}}
    </style>
</head>
<body>
    <%
        // BUG B fix: a property is opened by BOTH managers and employees. Render the
        // ADMIN sidebar for managers (super/admin/properties.manage) so they stay in
        // their own world — never dumped into employee chrome (Home→/dashboard, My
        // Leave, My Incentives). Employees keep the employee browse sidebar.
        var _isMgr = user && (user.access_role === 'admin' || user.access_role === 'super_admin'
            || (Array.isArray(user.navPerms) && (user.navPerms.indexOf('*') !== -1 || user.navPerms.indexOf('properties.manage') !== -1)));
    %>
    <% if (_isMgr) { %><%- include('admin/layout/sidebar') %><% } else { %><%- include('layout/sidebar') %><% } %>
    <div class="main-content">

    <div class="topbar">
        <div><a href="<%= typeof unitsBase !== 'undefined' && unitsBase ? unitsBase : '/projects' %>" class="back-link">← All Properties</a></div>
        <div class="topbar-right">
            <div class="user-pill"><div class="avatar-mini"><%= (user.name||'?').charAt(0).toUpperCase() %></div><div class="user-name"><%= user.name %></div></div>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>
    </div>

    <div class="page-body">
        <%
            var S = sheet;
            function money(v){ return (v!==null&&v!==undefined&&v!=='') ? ('₹'+Number(v).toLocaleString('en-IN')) : null; }
            var _price = money(unit.expected_price);
            var _psf   = money(unit.price_per_sqft);
            var _heading = unit.title || unit.property_type || 'Property';
            var _subParts = [];
            if (unit.locality) _subParts.push(unit.locality);
            if (unit.micro_market) _subParts.push(unit.micro_market);
            if (unit.pincode) _subParts.push(unit.pincode);
            var _amen = (unit.amenities && unit.amenities.length) ? unit.amenities : [];
        %>

        <!-- BREADCRUMB -->
        <div style="font-size:13px;color:#6b6b6b;margin-bottom:16px;">
            <a href="<%= typeof homePath !== 'undefined' && homePath ? homePath : '/dashboard' %>" style="color:#B8941F;text-decoration:none;font-weight:600;">Home</a> ›
            <a href="<%= typeof unitsBase !== 'undefined' && unitsBase ? unitsBase : '/projects' %>" style="color:#B8941F;text-decoration:none;font-weight:600;">Properties</a>
            › <span style="color:#0A1628;font-weight:600;"><%= _heading %></span>
        </div>

        <!-- HERO -->
        <div class="u-hero">
            <div class="badges">
                <% if (unit.category) { %><span class="cat-chip"><%= S.categoryLabel(unit.category) %></span><% } %>
                <% if (unit.status_of_property) { %><span class="status-badge"><%= S.statusLabel(unit.status_of_property) %></span><% } %>
                <% if (unit.property_type) { %><span class="type-chip"><%= unit.property_type %></span><% } %>
                <% if (unit.listing_sale) { %><span class="type-chip">🏷️ For Sale</span><% } %>
                <% if (unit.listing_rent) { %><span class="type-chip">🔑 For Rent</span><% } %>
            </div>
            <h1><%= _heading %></h1>
            <% if (_subParts.length) { %><div class="sub"><%= _subParts.join(' · ') %></div><% } %>
            <div class="price-row">
                <% if (_price) { %><div class="price-box"><div class="lbl">Expected Price</div><div class="val"><%= _price %></div></div><% } %>
                <% if (_psf) { %><div class="price-box"><div class="lbl">Rate / sq.ft</div><div class="val"><%= _psf %></div></div><% } %>
                <% if (unit.price_negotiable) { %><span class="neg-badge">Negotiable</span><% } %>
                <% if (canManage) { %><a href="/properties/<%= unit.property_id %>/edit" class="edit-btn">✎ Edit</a><% } %>
            </div>
        </div>

        <!-- SHEET GROUPS in order — each hides if it has nothing to show -->
        <% S.GROUPS.forEach(function(g){
            var cells = S.detailCells(unit, g, { canManage: canManage });
            var isBasic = (g.key === 'basic');
            var isAmen  = (g.key === 'amenities');
            var isAbout = (g.key === 'about');
            var hasOwner = isBasic && (unit.owner_name || unit.owner_phone || (canSeeOwnerInternal && (unit.owner_email || unit.owner_notes)));
            var hasChips = isAmen && _amen.length;
            var hasParking = isAmen && (unit.parking_available === true || unit.parking_available === false);
            var hasMap   = isAbout && map && map.embedSrc;
            var hasGallery = isAbout && ((images&&images.length)||(videos&&videos.length)||(floorPlans&&floorPlans.length));
            if (!cells.length && !hasOwner && !hasChips && !hasParking && !hasMap && !hasGallery) return;
        %>
        <div class="panel">
            <div class="panel-head"><h2>G<%= g.n %> · <%= g.title %></h2>
                <% if (hasMap && map.openUrl) { %><a href="<%= map.openUrl %>" target="_blank" rel="noopener" style="font-size:12px;font-weight:600;color:#0A1628;border:1px solid rgba(10,22,40,0.14);border-radius:8px;padding:6px 10px;text-decoration:none;">Open in Maps →</a><% } %>
            </div>
            <div class="panel-body">
                <% if (cells.length) { %>
                <div class="facts">
                    <% cells.forEach(function(c){ %><div class="fact"><div class="lbl"><%= c.label %></div><div class="val"><%= c.value %></div></div><% }); %>
                </div>
                <% } %>

                <% if (hasChips) { %>
                    <div class="gsub">Amenities</div>
                    <div class="chips"><% _amen.forEach(function(a){ %><span class="chip"><%= a %></span><% }); %></div>
                <% } %>

                <% if (hasParking) { %>
                    <div class="gsub">Parking</div>
                    <div class="chips">
                    <% if (unit.parking_available) { %>
                        <span class="chip">✓ Available</span>
                        <% if (unit.parking_type) { %><span class="chip"><%= S.cap(unit.parking_type) %></span><% } %>
                        <% if (unit.parking_count) { %><span class="chip"><%= unit.parking_count %> space<%= Number(unit.parking_count)===1?'':'s' %></span><% } %>
                    <% } else { %>
                        <span class="chip">✗ No parking</span>
                    <% } %>
                    </div>
                <% } %>

                <% if (hasOwner) { %>
                    <div class="gsub">Owner</div>
                    <div class="facts">
                        <% if (unit.owner_name) { %><div class="fact"><div class="lbl">Name</div><div class="val"><%= unit.owner_name %></div></div><% } %>
                        <% if (unit.owner_phone) { %><div class="fact"><div class="lbl">Phone</div><div class="val"><a href="tel:<%= unit.owner_phone %>" style="color:#0A1628;text-decoration:none;"><%= unit.owner_phone %></a></div></div><% } %>
                        <% if (canSeeOwnerInternal && unit.owner_email) { %><div class="fact"><div class="lbl">Email</div><div class="val"><%= unit.owner_email %></div></div><% } %>
                    </div>
                    <% if (canSeeOwnerInternal && unit.owner_notes) { %><div style="margin-top:12px;font-size:13px;color:#6b6b6b;"><span style="font-weight:600;">Notes:</span> <%= unit.owner_notes %></div><% } %>
                <% } %>

                <% if (hasMap) { %>
                    <div style="border-radius:12px;overflow:hidden;border:1px solid var(--border);margin-top:<%= cells.length?'14px':'0' %>;"><iframe src="<%= map.embedSrc %>" width="100%" height="300" style="border:0;display:block;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location map"></iframe></div>
                <% } %>

                <% if (hasGallery) { %>
                    <% if (images && images.length) { %><div class="gsub">Photos</div><div class="gallery"><% images.forEach(function(m){ %><img class="lb" src="<%= m.file_path %>" alt="Property photo"><% }); %></div><% } %>
                    <% if (videos && videos.length) { %><div class="gsub">Videos</div><div class="gallery"><% videos.forEach(function(m){ %><video src="<%= m.file_path %>" controls></video><% }); %></div><% } %>
                    <% if (floorPlans && floorPlans.length) { %><div class="gsub">Floor Plans</div><div class="gallery"><% floorPlans.forEach(function(m){ %><img src="<%= m.file_path %>" alt="Floor plan"><% }); %></div><% } %>
                <% } %>
            </div>
        </div>
        <% }); %>

        <!-- PARENT PROJECT (legacy link only) -->
        <% if (project) { %>
        <div class="panel">
            <div class="panel-head"><h2>Part of</h2></div>
            <div class="panel-body">
                <a href="<%= (typeof propsBase !== 'undefined' && propsBase) ? propsBase : '/projects' %>/<%= project.project_id %>" class="pcard">
                    <div class="mono"><%= (project.title||'?').charAt(0).toUpperCase() %></div>
                    <div>
                        <div class="nm"><%= project.title %></div>
                        <div class="mt"><% if(project.builder){ %>by <%= project.builder %> · <% } %><%= project.location || project.area_zone || '' %></div>
                    </div>
                </a>
            </div>
        </div>
        <% } %>

    </div>
    </div><!-- /.main-content -->
    <%# --- zero-dependency image lightbox (inlined; res.render context) ---
        Any <img class="lb"> becomes clickable: opens full-size in a dark overlay
        scaled to fit the viewport. Click anywhere or press Esc to close. Photos only. %>
    <style>
      img.lb { cursor: zoom-in; }
      #lb-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: none; align-items: center; justify-content: center;
        background: rgba(0,0,0,0.9); cursor: zoom-out;
      }
      #lb-overlay.open { display: flex; }
      #lb-overlay img {
        max-width: 92vw; max-height: 92vh;
        object-fit: contain; box-shadow: 0 8px 40px rgba(0,0,0,0.6);
        border-radius: 4px;
      }
      #lb-close {
        position: fixed; top: 18px; right: 24px; z-index: 10000;
        color: #fff; font-size: 34px; line-height: 1; cursor: pointer;
        background: none; border: none; opacity: 0.85;
      }
    </style>
    <div id="lb-overlay" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button id="lb-close" type="button" aria-label="Close">&times;</button>
      <img id="lb-img" src="" alt="">
    </div>
    <script>
      (function () {
        var overlay = document.getElementById('lb-overlay');
        var lbImg = document.getElementById('lb-img');
        if (!overlay || !lbImg) return;
        function open(src, alt) { lbImg.src = src; lbImg.alt = alt || ''; overlay.classList.add('open'); }
        function close() { overlay.classList.remove('open'); lbImg.src = ''; }
        document.addEventListener('click', function (e) {
          var img = e.target.closest && e.target.closest('img.lb');
          if (img) { e.preventDefault(); open(img.getAttribute('src'), img.getAttribute('alt')); }
        });
        overlay.addEventListener('click', close); // click anywhere on overlay (incl. image) closes
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });
      })();
    </script>
</body>
</html>
