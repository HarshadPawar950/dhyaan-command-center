<%
  // Read-only Client Profile chips (027 + 029 v2) for the lead detail pages.
  // Self-contained styling so it drops into either the admin or employee lead
  // detail. Expects `lead`.
  var l = (typeof lead !== 'undefined' && lead) ? lead : {};
  var arr = function(v){ return Array.isArray(v) ? v : (v == null || v === '' ? [] : [v]); };
  var cfg = arr(l.cp_configuration), poss = arr(l.cp_possession_pref), amen = arr(l.cp_amenities), floor = arr(l.cp_floor_pref);
  var LBL = { end_user:'End User', investor:'Investor', self:'Self', loan:'Loan', cash:'Cash',
    weekday:'Weekday', weekend:'Weekend', ready_to_move:'Ready to Move',
    under_construction:'Under Construction', pre_launch:'Pre Launch',
    residential:'Residential', commercial:'Commercial',
    standalone:'Stand Alone', township:'Township', gated:'Gated', cosmos:'Cosmos',
    business:'Business', salaried:'Salaried', retired:'Retired',
    with_amenities:'With Amenities', without:'Without Amenities',
    immediate:'Immediate', '1_3m':'1–3 months', '3_6m':'3–6 months', '6plus':'6+ months',
    lower:'Lower', mid:'Mid', higher:'Higher' };
  var BUD = { under_50l:'Under 50 Lakh', '50l_1cr':'50 Lakh–1 Cr', '1_3cr':'1–3 Cr', '3_10cr':'3–10 Cr', above_10cr:'Above 10 Cr', other:'Other' };
  function lab(s){ return LBL[s] || (s ? String(s).replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}) : ''); }
  function money(v){ return (v!==null&&v!==undefined&&v!=='') ? ('₹'+Number(v).toLocaleString('en-IN')) : null; }
  var dp = money(l.cp_down_payment);
  var budgetLabel = l.cp_budget_tag === 'other' ? (l.cp_budget_other || 'Other') : (BUD[l.cp_budget_tag] || lab(l.cp_budget_tag));
  var hasAny = cfg.length || poss.length || amen.length || floor.length || l.cp_use || l.cp_funding || dp
    || l.cp_budget_tag || l.cp_budget_other || l.cp_visit_pref || l.cp_urgency_note
    || l.cp_occupation || l.cp_layout_pref || l.cp_community_pref || l.cp_amenities_pref
    || l.cp_purchase_timeline || l.cp_projects_visited || l.cp_current_residence;
%>
<% if (hasAny) { %>
<div class="cpv-card">
  <div class="cpv-head">🎯 Client Profile</div>
  <div class="cpv-body">
    <% if (cfg.length) { %><div class="cpv-row"><span class="cpv-lbl">Configuration</span><span class="cpv-chips"><% cfg.forEach(function(c){ %><span class="cpv-chip"><%= lab(c) %></span><% }); %></span></div><% } %>
    <% if (l.cp_use) { %><div class="cpv-row"><span class="cpv-lbl">Use</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_use) %></span></span></div><% } %>
    <% if (l.cp_occupation) { %><div class="cpv-row"><span class="cpv-lbl">Occupation</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_occupation) %></span></span></div><% } %>
    <% if (l.cp_layout_pref) { %><div class="cpv-row"><span class="cpv-lbl">Layout</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_layout_pref) %></span></span></div><% } %>
    <% if (l.cp_community_pref) { %><div class="cpv-row"><span class="cpv-lbl">Community</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_community_pref) %></span></span></div><% } %>
    <% if (l.cp_amenities_pref) { %><div class="cpv-row"><span class="cpv-lbl">Amenities</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_amenities_pref) %></span></span></div><% } %>
    <% if (poss.length) { %><div class="cpv-row"><span class="cpv-lbl">Possession</span><span class="cpv-chips"><% poss.forEach(function(c){ %><span class="cpv-chip"><%= lab(c) %></span><% }); %></span></div><% } %>
    <% if (l.cp_purchase_timeline) { %><div class="cpv-row"><span class="cpv-lbl">Timeline</span><span class="cpv-chips"><span class="cpv-chip"><%= lab(l.cp_purchase_timeline) %></span></span></div><% } %>
    <% if (floor.length) { %><div class="cpv-row"><span class="cpv-lbl">Floor</span><span class="cpv-chips"><% floor.forEach(function(c){ %><span class="cpv-chip"><%= lab(c) %></span><% }); %></span></div><% } %>
    <% if (l.cp_funding || dp) { %><div class="cpv-row"><span class="cpv-lbl">Funding</span><span class="cpv-chips"><% if (l.cp_funding) { %><span class="cpv-chip"><%= lab(l.cp_funding) %></span><% } %><% if (dp) { %><span class="cpv-chip">Down Payment <%= dp %></span><% } %></span></div><% } %>
    <% if (l.cp_budget_tag || l.cp_budget_other) { %><div class="cpv-row"><span class="cpv-lbl">Budget Tag</span><span class="cpv-chips"><span class="cpv-chip cpv-gold"><%= budgetLabel %></span></span></div><% } %>
    <% if (l.cp_projects_visited) { %><div class="cpv-row"><span class="cpv-lbl">Project Visited</span><span class="cpv-chips"><span class="cpv-note"><%= l.cp_projects_visited %></span></span></div><% } %>
    <% if (l.cp_current_residence) { %><div class="cpv-row"><span class="cpv-lbl">Current Residence</span><span class="cpv-chips"><span class="cpv-note"><%= l.cp_current_residence %></span></span></div><% } %>
    <% if (amen.length) { %><div class="cpv-row"><span class="cpv-lbl">Amenities (legacy)</span><span class="cpv-chips"><% amen.forEach(function(c){ %><span class="cpv-chip"><%= c %></span><% }); %></span></div><% } %>
    <% if (l.cp_visit_pref || l.cp_urgency_note) { %><div class="cpv-row"><span class="cpv-lbl">Urgency</span><span class="cpv-chips"><% if (l.cp_visit_pref) { %><span class="cpv-chip"><%= lab(l.cp_visit_pref) %> visits</span><% } %><% if (l.cp_urgency_note) { %><span class="cpv-note"><%= l.cp_urgency_note %></span><% } %></span></div><% } %>
  </div>
</div>
<style>
  .cpv-card{background:#fff;border:1px solid rgba(10,22,40,0.08);border-radius:14px;box-shadow:0 4px 24px rgba(10,22,40,0.06);overflow:hidden;margin-bottom:22px;}
  .cpv-head{padding:14px 22px;border-bottom:1px solid rgba(10,22,40,0.08);font-family:'Playfair Display',serif;font-weight:600;color:#0A1628;font-size:17px;}
  .cpv-body{padding:16px 22px;display:flex;flex-direction:column;gap:12px;}
  .cpv-row{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;}
  .cpv-lbl{min-width:110px;font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:#6b6b6b;font-weight:700;padding-top:5px;}
  .cpv-chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
  .cpv-chip{font-size:12px;font-weight:600;color:#0A1628;background:#F4EFE6;border-radius:999px;padding:6px 13px;}
  .cpv-chip.cpv-gold{background:linear-gradient(135deg,#D4AF37,#E8C766);}
  .cpv-note{font-size:13px;color:#6b6b6b;font-style:italic;}
</style>
<% } %>
