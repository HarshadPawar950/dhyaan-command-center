<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Dhyaan Realty</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .inc-wrap { padding: 0 32px 32px; }
    .tot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0; }
    .tot { background: #fff; border-radius: 12px; padding: 18px 20px; box-shadow: 0 2px 10px rgba(10,22,40,0.06); border-top: 3px solid #9ca3af; }
    .tot.accrued { border-top-color: #d97706; } .tot.payable { border-top-color: #2563eb; } .tot.paid { border-top-color: #16a34a; }
    .tot .lbl { font-size: 12px; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; font-weight: 600; }
    .tot .val { font-size: 26px; font-weight: 700; color: #0A1628; margin-top: 6px; }
    .card { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 10px rgba(10,22,40,0.06); }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .table-scroll table { min-width: 560px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: #6b7280; padding: 9px 10px; border-bottom: 2px solid #eef; }
    th.num, td.num { text-align: right; }
    td { padding: 9px 10px; border-bottom: 1px solid #f3f4f6; }
    .st { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .st.accrued { background: #FEF3C7; color: #92400E; } .st.payable { background: #DBEAFE; color: #1E40AF; } .st.paid { background: #DCFCE7; color: #166534; }
    .empty { color: #9ca3af; font-style: italic; padding: 16px; text-align: center; }
    .hint { font-size: 12px; color: #9ca3af; margin-top: 6px; }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('layout/sidebar') %>
    <main class="main-content">
      <%- include('layout/topbar') %>
      <%- include('layout/messages') %>
      <div class="page-hero">
        <h1>My Incentives</h1>
        <p>Accrued on booking → payable once the builder commission is received → paid by HR.</p>
      </div>

      <div class="inc-wrap">
        <% if (noEmp) { %>
          <div class="card"><div class="empty">We couldn't resolve your employee record. Contact HR.</div></div>
        <% } else { %>

        <div class="tot-grid">
          <div class="tot accrued"><div class="lbl">Accrued</div><div class="val">&#8377;<%= Number(totals.accrued).toLocaleString('en-IN', {maximumFractionDigits:0}) %></div></div>
          <div class="tot payable"><div class="lbl">Payable</div><div class="val">&#8377;<%= Number(totals.payable).toLocaleString('en-IN', {maximumFractionDigits:0}) %></div></div>
          <div class="tot paid"><div class="lbl">Paid</div><div class="val">&#8377;<%= Number(totals.paid).toLocaleString('en-IN', {maximumFractionDigits:0}) %></div></div>
        </div>

        <div class="card">
          <div class="table-scroll">
          <table>
            <thead><tr><th>Commission</th><th class="num">Base (share)</th><th class="num">Rate</th><th class="num">Incentive</th><th>Status</th><th>Gating</th></tr></thead>
            <tbody>
              <% if (entries.length) { %>
                <% entries.forEach(function(e) { %>
                  <tr>
                    <td><%= e.commission_ref || '—' %></td>
                    <td class="num">&#8377;<%= Number(e.base_amount).toLocaleString('en-IN', {maximumFractionDigits:0}) %></td>
                    <td class="num"><%= e.slab_rate %>%</td>
                    <td class="num">&#8377;<%= Number(e.incentive_amount).toLocaleString('en-IN', {maximumFractionDigits:0}) %></td>
                    <td><span class="st <%= e.status %>"><%= e.status %></span></td>
                    <td style="font-size:11px;color:#6b7280;"><%= e.receivable_status ? e.receivable_status.replace(/_/g,' ') : '—' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="6" class="empty">No incentive entries yet — they appear when a commission is logged on your booking.</td></tr>
              <% } %>
            </tbody>
          </table>
          </div>
          <div class="hint">An incentive becomes <strong>payable</strong> only when the builder commission for that deal is fully received.</div>
        </div>

        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
