<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Dhyaan Realty</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .leave-wrap { padding: 0 32px 32px; }
    .bal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin: 24px 0; }
    .bal-card { background: #fff; border-radius: 12px; padding: 18px 20px; box-shadow: 0 2px 10px rgba(10,22,40,0.06); border-top: 3px solid #D4AF37; }
    .bal-card .name { font-size: 12px; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; font-weight: 600; }
    .bal-card .bal { font-size: 30px; font-weight: 700; color: #0A1628; line-height: 1; margin: 8px 0 4px; }
    .bal-card .bal.zero { color: #dc2626; }
    .bal-card .sub { font-size: 12px; color: #9ca3af; }
    .two-col { display: grid; grid-template-columns: 360px 1fr; gap: 20px; align-items: start; }
    .card { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 10px rgba(10,22,40,0.06); margin-top: 0; }
    .card h2 { font-size: 16px; color: #0A1628; margin-bottom: 14px; }
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 5px; }
    .field input, .field select, .field textarea { width: 100%; padding: 9px 11px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; font-family: inherit; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: #6b7280; padding: 9px 10px; border-bottom: 2px solid #eef; }
    td { padding: 9px 10px; border-bottom: 1px solid #f3f4f6; }
    .st { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .st.pending { background: #FEF3C7; color: #92400E; } .st.approved { background: #DCFCE7; color: #166534; } .st.rejected { background: #FEE2E2; color: #991B1B; }
    .empty { color: #9ca3af; font-style: italic; padding: 16px; text-align: center; }
    @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('layout/sidebar') %>
    <main class="main-content">
      <%- include('layout/topbar') %>
      <%- include('layout/messages') %>
      <div class="page-hero">
        <h1>My Leave</h1>
        <p>Your balances, request form, and request history.</p>
      </div>

      <div class="leave-wrap">
        <% if (noEmp) { %>
          <div class="card"><div class="empty">We couldn't resolve your employee record. Contact HR.</div></div>
        <% } else { %>

        <div class="bal-grid">
          <% balances.forEach(function(b) { %>
            <div class="bal-card">
              <div class="name"><%= b.name %></div>
              <div class="bal <%= b.balance <= 0 ? 'zero' : '' %>"><%= b.balance %></div>
              <div class="sub"><%= b.used %> used of <%= b.annual_quota %> this year</div>
            </div>
          <% }); %>
          <% if (!balances.length) { %><div class="bal-card"><div class="empty">No leave types configured.</div></div><% } %>
        </div>

        <div class="two-col">
          <div class="card">
            <h2>Request Leave</h2>
            <form method="POST" action="/leave">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label>Leave Type</label>
                <select name="leave_type_id" required>
                  <option value="">— Select —</option>
                  <% types.forEach(function(t) { %>
                    <option value="<%= t.leave_type_id %>" data-frac="<%= t.day_fraction %>"><%= t.name %> (<%= t.annual_quota %>/yr)</option>
                  <% }); %>
                </select>
              </div>
              <div class="field"><label>From</label><input type="date" name="from_date" required></div>
              <div class="field"><label>To</label><input type="date" name="to_date" required></div>
              <div class="field"><label>Reason</label><textarea name="reason" rows="2" maxlength="500" placeholder="Optional"></textarea></div>
              <button type="submit" class="btn btn-accent" style="width:100%;padding:11px;">Submit Request</button>
            </form>
          </div>

          <div class="card">
            <h2>My Requests</h2>
            <table>
              <thead><tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th></tr></thead>
              <tbody>
                <% if (requests.length) { %>
                  <% requests.forEach(function(r) { %>
                    <tr>
                      <td><%= r.type_name %></td>
                      <td><%= new Date(r.from_date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></td>
                      <td><%= new Date(r.to_date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></td>
                      <td><%= r.days %></td>
                      <td><span class="st <%= r.status %>"><%= r.status %></span></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="5" class="empty">No requests yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <% } %>
      </div>
    </main>
  </div>
  <script>
    // Half-day leave types (day_fraction < 1) lock the To-date to a single day.
    (function () {
      var sel = document.querySelector('select[name="leave_type_id"]'),
          from = document.querySelector('input[name="from_date"]'),
          to = document.querySelector('input[name="to_date"]');
      if (!sel || !from || !to) return;
      function frac() { var o = sel.options[sel.selectedIndex]; return o ? parseFloat(o.getAttribute('data-frac') || '1') : 1; }
      function sync() {
        if (frac() < 1) { to.value = from.value; to.readOnly = true; to.style.background = '#f3f4f6'; }
        else { to.readOnly = false; to.style.background = ''; }
      }
      sel.addEventListener('change', sync);
      from.addEventListener('change', function () { if (frac() < 1) to.value = from.value; });
      sync();
    })();
  </script>
</body>
</html>
